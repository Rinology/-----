<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 모던 라이트 테마 컬러 팔레트 -->
    <SolidColorBrush x:Key="ThemeBg" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="ThemeSurfaceBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeText" Color="#18181B"/>
    <SolidColorBrush x:Key="ThemeSubText" Color="#71717A"/>
    <SolidColorBrush x:Key="ThemeBorder" Color="#E4E4E7"/>
    <SolidColorBrush x:Key="ThemeAccent" Color="#2563EB"/>
    <SolidColorBrush x:Key="ThemeTitleBg" Color="#2563EB"/>
    <SolidColorBrush x:Key="ThemeTitleText" Color="#FFFFFF"/>

    <!-- 모던 라이트 버튼 스타일 -->
    <Style x:Key="ThemeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#18181B"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="#D4D4D8" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#F4F4F5"/>
                            <Setter TargetName="Brd" Property="BorderBrush" Value="#2563EB"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#DBEAFE"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 모던 라이트 텍스트박스 스타일 -->
    <Style x:Key="ThemeTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#18181B"/>
        <Setter Property="BorderBrush" Value="#D4D4D8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Brd" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="#2563EB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 모던 라이트 최소화 버튼 -->
    <Style x:Key="ThemeMinimizeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <TextBlock Text="—" Foreground="{TemplateBinding Foreground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#1D4ED8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 모던 라이트 닫기 버튼 -->
    <Style x:Key="ThemeCloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <TextBlock Text="✕" Foreground="{TemplateBinding Foreground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#EF4444"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 호환용 별칭 -->
    <StaticResource x:Key="Win98WindowBg" ResourceKey="ThemeBg"/>
    <StaticResource x:Key="Win98TitleGradient" ResourceKey="ThemeTitleBg"/>
    <StaticResource x:Key="Win98ButtonStyle" ResourceKey="ThemeButtonStyle"/>
    <StaticResource x:Key="Win98TextBoxStyle" ResourceKey="ThemeTextBoxStyle"/>
    <StaticResource x:Key="Win98MinimizeButtonStyle" ResourceKey="ThemeMinimizeButtonStyle"/>
    <StaticResource x:Key="Win98CloseButtonStyle" ResourceKey="ThemeCloseButtonStyle"/>
</ResourceDictionary>
