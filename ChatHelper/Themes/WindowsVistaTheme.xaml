<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 비스타 에어로 글래스 구조 속성 (부드러운 라운드 & 반투명 패널) -->
    <CornerRadius x:Key="ThemeWindowCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ThemePanelCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemeButtonCornerRadius">14</CornerRadius>
    <Thickness x:Key="ThemeWindowBorderThickness">1.5</Thickness>
    <SolidColorBrush x:Key="ThemePanelBg" Color="#1E2A38"/>
    <SolidColorBrush x:Key="ThemePanelBorder" Color="#38BDF8"/>

    <!-- 윈도우 비스타 에어로 글래스 컬러 팔레트 -->
    <SolidColorBrush x:Key="ThemeBg" Color="#15202B"/>
    <SolidColorBrush x:Key="ThemeSurfaceBg" Color="#1E2A38"/>
    <SolidColorBrush x:Key="ThemeText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeSubText" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ThemeBorder" Color="#38BDF8"/>
    <SolidColorBrush x:Key="ThemeAccent" Color="#0284C7"/>
    <SolidColorBrush x:Key="ThemeTitleText" Color="#FFFFFF"/>

    <!-- 비스타 에어로 글래스 타이틀 바 그라데이션 -->
    <LinearGradientBrush x:Key="ThemeTitleBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0284C7" Offset="0.0"/>
        <GradientStop Color="#075985" Offset="0.5"/>
        <GradientStop Color="#0C4A6E" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 비스타 둥근 광택(Glossy) 입체 버튼 스타일 -->
    <Style x:Key="ThemeButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" CornerRadius="12" BorderThickness="1" BorderBrush="#38BDF8" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0284C7" Offset="0.0"/>
                                <GradientStop Color="#0369A1" Offset="0.5"/>
                                <GradientStop Color="#0C4A6E" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="#7DD3FC"/>
                            <Setter TargetName="Brd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#38BDF8" Offset="0.0"/>
                                        <GradientStop Color="#0284C7" Offset="0.5"/>
                                        <GradientStop Color="#0369A1" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#082F49"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 비스타 에어로 텍스트박스 스타일 -->
    <Style x:Key="ThemeTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#0F172A"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="#38BDF8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Brd" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="#38BDF8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 비스타 최소화 버튼 -->
    <Style x:Key="ThemeMinimizeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#BAE6FD"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <TextBlock Text="—" Foreground="{TemplateBinding Foreground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#0369A1"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 비스타 닫기 버튼 -->
    <Style x:Key="ThemeCloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#BAE6FD"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <TextBlock Text="✕" Foreground="{TemplateBinding Foreground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#DC2626"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <StaticResource x:Key="Win98WindowBg" ResourceKey="ThemeBg"/>
    <StaticResource x:Key="Win98TitleGradient" ResourceKey="ThemeTitleBg"/>
    <StaticResource x:Key="Win98ButtonStyle" ResourceKey="ThemeButtonStyle"/>
    <StaticResource x:Key="Win98TextBoxStyle" ResourceKey="ThemeTextBoxStyle"/>
    <StaticResource x:Key="Win98MinimizeButtonStyle" ResourceKey="ThemeMinimizeButtonStyle"/>
    <StaticResource x:Key="Win98CloseButtonStyle" ResourceKey="ThemeCloseButtonStyle"/>
</ResourceDictionary>
