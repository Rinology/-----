<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 윈도우 10 모던 플랫 컬러 팔레트 -->
    <SolidColorBrush x:Key="ThemeBg" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="ThemeSurfaceBg" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ThemeText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeSubText" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ThemeBorder" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="ThemeAccent" Color="#0078D7"/>
    <SolidColorBrush x:Key="ThemeTitleBg" Color="#171717"/>
    <SolidColorBrush x:Key="ThemeTitleText" Color="#FFFFFF"/>

    <!-- 윈도우 10 플랫 타일 버튼 스타일 -->
    <Style x:Key="ThemeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="#444444" 
                            BorderThickness="1" 
                            CornerRadius="0" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#0078D7"/>
                            <Setter TargetName="Brd" Property="BorderBrush" Value="#0078D7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#005A9E"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 윈도우 10 직사각형 텍스트박스 스타일 -->
    <Style x:Key="ThemeTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#555555"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Brd" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="0">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="#0078D7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 윈도우 10 최소화 버튼 -->
    <Style x:Key="ThemeMinimizeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}">
                        <TextBlock Text="—" Foreground="{TemplateBinding Foreground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#333333"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 윈도우 10 닫기 버튼 -->
    <Style x:Key="ThemeCloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}">
                        <TextBlock Text="✕" Foreground="{TemplateBinding Foreground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <StaticResource x:Key="Win98WindowBg" ResourceKey="ThemeBg"/>
    <StaticResource x:Key="Win98TitleGradient" ResourceKey="ThemeTitleBg"/>
    <StaticResource x:Key="Win98ButtonStyle" ResourceKey="ThemeButtonStyle"/>
    <StaticResource x:Key="Win98TextBoxStyle" ResourceKey="ThemeTextBoxStyle"/>
    <StaticResource x:Key="Win98MinimizeButtonStyle" ResourceKey="ThemeMinimizeButtonStyle"/>
    <StaticResource x:Key="Win98CloseButtonStyle" ResourceKey="ThemeCloseButtonStyle"/>
</ResourceDictionary>
