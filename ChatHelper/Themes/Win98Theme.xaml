<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 윈도우 98 클래식 컬러 팔레트 -->
    <SolidColorBrush x:Key="Win98WindowBg" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Win98BtnFace" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Win98BtnHighlight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Win98BtnShadow" Color="#808080"/>
    <SolidColorBrush x:Key="Win98BtnDarkShadow" Color="#000000"/>
    <SolidColorBrush x:Key="Win98Text" Color="#000000"/>

    <!-- 윈도우 98 타이틀 바 그라데이션 -->
    <LinearGradientBrush x:Key="Win98TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#000080" Offset="0.0"/>
        <GradientStop Color="#1084D0" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 윈도우 98 클래식 3D 버튼 스타일 -->
    <Style x:Key="Win98ButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="Malgun Gothic, Gulim, Tahoma"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderThickness="1" BorderBrush="#000000">
                        <Border x:Name="InnerBorder" BorderThickness="1" BorderBrush="#FFFFFF" Background="{TemplateBinding Background}">
                            <Border BorderThickness="0,0,1,1" BorderBrush="#808080" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="InnerBorder" Property="BorderBrush" Value="#808080"/>
                            <Setter Property="Background" Value="#B0B0B0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 윈도우 98 안으로 파인(Sunken) 입력창 스타일 -->
    <Style x:Key="Win98TextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="Malgun Gothic, Gulim, Tahoma"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border BorderThickness="1,1,0,0" BorderBrush="#808080">
                        <Border BorderThickness="1,1,0,0" BorderBrush="#000000">
                            <Border BorderThickness="0,0,1,1" BorderBrush="#FFFFFF" Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 윈도우 98 최소화/숨기기 버튼 스타일 [ _ ] -->
    <Style x:Key="Win98MinimizeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderThickness="1" BorderBrush="#000000">
                        <Border x:Name="Brd" BorderThickness="1" BorderBrush="#FFFFFF" Background="#C0C0C0">
                            <Border BorderThickness="0,0,1,1" BorderBrush="#808080">
                                <TextBlock Text="0" FontFamily="Marlett" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="#808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 윈도우 98 닫기 버튼 스타일 [ X ] -->
    <Style x:Key="Win98CloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderThickness="1" BorderBrush="#000000">
                        <Border x:Name="Brd" BorderThickness="1" BorderBrush="#FFFFFF" Background="#C0C0C0">
                            <Border BorderThickness="0,0,1,1" BorderBrush="#808080">
                                <TextBlock Text="r" FontFamily="Marlett" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="#808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
