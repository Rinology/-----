<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 98 / Millennium Edition 구조 속성 (완전 직각, 0 CornerRadius) -->
    <CornerRadius x:Key="ThemeWindowCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ThemePanelCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ThemeButtonCornerRadius">0</CornerRadius>
    <Thickness x:Key="ThemeWindowBorderThickness">2</Thickness>
    <SolidColorBrush x:Key="ThemePanelBg" Color="#D4D0C8"/>
    <SolidColorBrush x:Key="ThemePanelBorder" Color="#808080"/>

    <!-- 공통 컬러 팔레트 (전통 Windows 98 ME) -->
    <SolidColorBrush x:Key="ThemeBg" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="ThemeSurfaceBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeText" Color="#000000"/>
    <SolidColorBrush x:Key="ThemeSubText" Color="#444444"/>
    <SolidColorBrush x:Key="ThemeBorder" Color="#808080"/>
    <SolidColorBrush x:Key="ThemeAccent" Color="#000080"/>
    <SolidColorBrush x:Key="ThemeTitleText" Color="#FFFFFF"/>

    <!-- 윈도우 98 클래식 컬러 팔레트 -->
    <SolidColorBrush x:Key="Win98WindowBg" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Win98BtnFace" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Win98BtnHighlight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Win98BtnShadow" Color="#808080"/>
    <SolidColorBrush x:Key="Win98BtnDarkShadow" Color="#000000"/>
    <SolidColorBrush x:Key="Win98Text" Color="#000000"/>

    <!-- 윈도우 98 / ME 클래식 네이비-스카이블루 그라데이션 타이틀 바 -->
    <LinearGradientBrush x:Key="Win98TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#000080" Offset="0.0"/>
        <GradientStop Color="#1084D0" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemeTitleBg" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#000080" Offset="0.0"/>
        <GradientStop Color="#1084D0" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 윈도우 98 정통 3D 푸시 버튼 스타일 -->
    <Style x:Key="Win98ButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="Tahoma, Gulim, Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="OuterTopLeft" BorderThickness="1,1,0,0" BorderBrush="#FFFFFF">
                        <Border x:Name="OuterBottomRight" BorderThickness="0,0,1,1" BorderBrush="#000000">
                            <Border x:Name="InnerTopLeft" BorderThickness="1,1,0,0" BorderBrush="#DFDFDF">
                                <Border x:Name="InnerBottomRight" BorderThickness="0,0,1,1" BorderBrush="#808080" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterTopLeft" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="OuterTopLeft" Property="BorderBrush" Value="#000000"/>
                            <Setter TargetName="OuterBottomRight" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="OuterBottomRight" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="InnerTopLeft" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="InnerTopLeft" Property="BorderBrush" Value="#808080"/>
                            <Setter TargetName="InnerBottomRight" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="InnerBottomRight" Property="BorderBrush" Value="#DFDFDF"/>
                            <Setter Property="Background" Value="#AFAFAF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 윈도우 98 안으로 파인(Sunken) 입력창 스타일 -->
    <Style x:Key="Win98TextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="Tahoma, Gulim, Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border BorderThickness="1,1,0,0" BorderBrush="#808080">
                        <Border BorderThickness="0,0,1,1" BorderBrush="#FFFFFF">
                            <Border BorderThickness="1,1,0,0" BorderBrush="#000000">
                                <Border BorderThickness="0,0,1,1" BorderBrush="#DFDFDF" Background="{TemplateBinding Background}">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 윈도우 98 안으로 파인(Sunken) 패스워드 입력창 스타일 -->
    <Style x:Key="Win98PasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="Tahoma, Gulim, Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border BorderThickness="1,1,0,0" BorderBrush="#808080">
                        <Border BorderThickness="0,0,1,1" BorderBrush="#FFFFFF">
                            <Border BorderThickness="1,1,0,0" BorderBrush="#000000">
                                <Border BorderThickness="0,0,1,1" BorderBrush="#DFDFDF" Background="{TemplateBinding Background}">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 윈도우 98 타이틀 바 최소화 버튼 [ — ] -->
    <Style x:Key="Win98MinimizeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd1" BorderThickness="1,1,0,0" BorderBrush="#FFFFFF">
                        <Border x:Name="Brd2" BorderThickness="0,0,1,1" BorderBrush="#000000">
                            <Border x:Name="Brd3" BorderThickness="0,0,1,1" BorderBrush="#808080" Background="#C0C0C0">
                                <TextBlock Text="—" FontSize="8" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd1" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="Brd1" Property="BorderBrush" Value="#000000"/>
                            <Setter TargetName="Brd2" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="Brd2" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="Brd3" Property="Background" Value="#A0A0A0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 윈도우 98 타이틀 바 닫기 버튼 [ ✕ ] -->
    <Style x:Key="Win98CloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd1" BorderThickness="1,1,0,0" BorderBrush="#FFFFFF">
                        <Border x:Name="Brd2" BorderThickness="0,0,1,1" BorderBrush="#000000">
                            <Border x:Name="Brd3" BorderThickness="0,0,1,1" BorderBrush="#808080" Background="#C0C0C0">
                                <TextBlock Text="✕" FontSize="9" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd1" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="Brd1" Property="BorderBrush" Value="#000000"/>
                            <Setter TargetName="Brd2" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="Brd2" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="Brd3" Property="Background" Value="#A0A0A0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 테마 공통 별칭 매핑 -->
    <StaticResource x:Key="ThemeButtonStyle" ResourceKey="Win98ButtonStyle"/>
    <StaticResource x:Key="ThemeTextBoxStyle" ResourceKey="Win98TextBoxStyle"/>
    <StaticResource x:Key="ThemePasswordBoxStyle" ResourceKey="Win98PasswordBoxStyle"/>
    <StaticResource x:Key="ThemeMinimizeButtonStyle" ResourceKey="Win98MinimizeButtonStyle"/>
    <StaticResource x:Key="ThemeCloseButtonStyle" ResourceKey="Win98CloseButtonStyle"/>
</ResourceDictionary>
