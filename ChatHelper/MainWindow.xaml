<Window x:Class="ChatHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper Millennium Edition" 
        Height="172" Width="590"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded">

    <!-- 윈도우 98/Me 정통 4단계 3D Raised 입체 프레임 -->
    <Border BorderThickness="1,1,0,0" BorderBrush="#FFFFFF">
        <Border BorderThickness="0,0,1,1" BorderBrush="#000000">
            <Border BorderThickness="1,1,0,0" BorderBrush="#DFDFDF">
                <Border BorderThickness="0,0,1,1" BorderBrush="#808080" Background="#C0C0C0" Padding="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 타이틀 바 (그라데이션 및 키보드 아이콘) -->
                        <Grid Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                <TextBlock Text="⌨" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI Emoji, Tahoma"/>
                                <TextBlock x:Name="TxtTitleBar" Text="ChatHelper Millennium Edition - 실행 중" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" FontFamily="Tahoma, Gulim, Segoe UI"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                                <Button Style="{DynamicResource ThemeMinimizeButtonStyle}" ToolTip="트레이로 숨기기 (_)" Margin="0,0,3,0" Click="BtnHideToTray_Click"/>
                                <Button Style="{DynamicResource ThemeCloseButtonStyle}" ToolTip="프로그램 종료 (X)" Click="BtnExit_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- 상태 전광판 (Sunken 3D Bevel) -->
                        <Border Grid.Row="1" Margin="4,7,4,6" BorderThickness="1,1,0,0" BorderBrush="#808080">
                            <Border BorderThickness="0,0,1,1" BorderBrush="#FFFFFF">
                                <Border BorderThickness="1,1,0,0" BorderBrush="#000000">
                                    <Border BorderThickness="0,0,1,1" BorderBrush="#DFDFDF" Background="#D4D0C8" Padding="12,6">
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#00A000" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="LblRunningStatus" Text="자동완성 작동 중 (ON)" FontSize="13" FontWeight="Bold" Foreground="#000000" FontFamily="Tahoma, Gulim, Segoe UI" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="LblSubStatus" Text="👤 계정: taerin   |   📋 템플릿: 65개   |   ⌨️ 완성키: \ + Tab" FontSize="11.5" Foreground="#333333" FontFamily="Tahoma, Gulim, Segoe UI"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>

                        <!-- 하단 액션 버튼 5개 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,2,4,4">
                            <Button Content="💻 제어판" Style="{DynamicResource ThemeButtonStyle}" MinWidth="95" Height="30" FontSize="11" Margin="0,0,4,0" Click="BtnControlPanel_Click"/>
                            <Button Content="🔍 검색 (Alt+Q)" Style="{DynamicResource ThemeButtonStyle}" MinWidth="110" Height="30" FontSize="11" Margin="0,0,4,0" Click="BtnQuickSearch_Click"/>
                            <Button Content="🤖 AI비서 (Alt+X)" Style="{DynamicResource ThemeButtonStyle}" MinWidth="115" Height="30" FontSize="11" FontWeight="Bold" Margin="0,0,4,0" Click="BtnQuickAi_Click"/>
                            <Button x:Name="BtnTogglePause" Content="⏸️ 일시정지" Style="{DynamicResource ThemeButtonStyle}" MinWidth="95" Height="30" FontSize="11" Margin="0,0,4,0" Click="BtnTogglePause_Click"/>
                            <Button Content="🔽 트레이 이동" Style="{DynamicResource ThemeButtonStyle}" MinWidth="100" Height="30" FontSize="11" Click="BtnHideToTray_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
