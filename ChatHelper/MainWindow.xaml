<Window x:Class="ChatHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper"
        Height="48" Width="624"
        WindowStyle="None"
        Background="{DynamicResource ThemeHudBg}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded">

    <Grid Margin="0">
        <!-- 모던 플로팅 HUD 도킹 바 -->
        <Border Background="{DynamicResource ThemeHudBg}"
                BorderBrush="{DynamicResource ThemeHudBorder}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="10,6"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <StackPanel>
                <!-- 1행: 초슬림 1줄 HUD 도킹 바 (▲/▼ 수동 전환형 롤링 뷰) -->
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 상태 점 + ON/OFF 토글 -->
                    <Button x:Name="BtnTogglePause" Grid.Column="0" Style="{DynamicResource ThemeDockButtonStyle}"
                            Padding="6,3" Margin="0,0,4,0" ToolTip="클릭하여 자동완성 ON/OFF 전환" Click="BtnTogglePause_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LblRunningStatus" Text="ON" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" FontFamily="Malgun Gothic, Segoe UI"/>
                        </StackPanel>
                    </Button>

                    <!-- ▲/▼ 화면(뷰) 전환 컨트롤 (유저가 직접 선택할 때만 화면 전환) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Content="▲" Style="{DynamicResource ThemeDockButtonStyle}" Padding="5,2" FontSize="9.5" ToolTip="이전 화면 보기 (메뉴 ↔ 인식 상태 ↔ 최근 로그)" Click="BtnDockViewPrev_Click"/>
                        <TextBlock x:Name="TxtDockViewIndex" Text="1/3" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSubText}" VerticalAlignment="Center" Margin="3,0"/>
                        <Button Content="▼" Style="{DynamicResource ThemeDockButtonStyle}" Padding="5,2" FontSize="9.5" ToolTip="다음 화면 보기 (메뉴 ↔ 인식 상태 ↔ 최근 로그)" Click="BtnDockViewNext_Click"/>
                    </StackPanel>

                    <!-- 세로 구분선 -->
                    <Border Grid.Column="2" Width="1" Height="18" Background="{DynamicResource ThemePanelBorder}" Margin="0,0,8,0"/>

                    <!-- 중앙 전환 영역 (▲/▼ 버튼에 따라 3개 뷰 중 1개만 표시) -->
                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <!-- 뷰 1 (기본): 시트 선택 & 빠른 메뉴 (검색 · 기호 · 동기화 · 로그 · 설정) -->
                        <Grid x:Name="DockViewMenu" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbMainProfile" Grid.Column="0" Width="100" Height="26" FontSize="11.5"
                                      VerticalContentAlignment="Center" Margin="0,0,6,0"
                                      ToolTip="업무 프로필(스프레드시트) 즉시 전환"
                                      SelectionChanged="CmbMainProfile_SelectionChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="검색" Style="{DynamicResource ThemeDockButtonStyle}" ToolTip="템플릿 빠른 검색 (Alt+Q)" Click="BtnQuickSearch_Click"/>
                                <Button Content="기호" Style="{DynamicResource ThemeDockButtonStyle}" ToolTip="특수기호 입력 (Alt+X)" Click="BtnSymbolPicker_Click"/>
                                <TextBlock x:Name="LblSyncStatus" Text="↻ 0" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeSubText}" VerticalAlignment="Center"
                                           Padding="6,4" Cursor="Hand"
                                           ToolTip="클릭하여 지금 즉시 구글 시트 동기화"
                                           MouseLeftButtonUp="LblSyncStatus_MouseLeftButtonUp"/>
                                <Button x:Name="BtnToggleLog" Content="로그" Style="{DynamicResource ThemeDockButtonStyle}" ToolTip="실시간 상태 로그 열기/닫기" Click="BtnToggleLog_Click"/>
                                <Button Content="설정" Style="{DynamicResource ThemeDockButtonStyle}" ToolTip="제어판 열기" Click="BtnControlPanel_Click"/>
                                <Border x:Name="BadgeNotice" Visibility="Collapsed" Background="#16A34A" CornerRadius="10" Padding="7,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtNotice" Text="완료" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10.5" FontFamily="Malgun Gothic, Segoe UI"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 뷰 2: 실시간 타이핑 인식 현황 (어디까지 인식되었는지 한눈에 확인) -->
                        <Grid x:Name="DockViewRecognition" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource ThemePanelBg}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="인식 현황" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                            </Border>
                            <TextBlock x:Name="TxtDockRecognitionStatus" Grid.Column="1"
                                       Text="⏳ 대기중 — 채팅창에 단축어 또는 키워드를 입력하세요"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Content="설정" Style="{DynamicResource ThemeDockButtonStyle}" Margin="6,0,0,0" Click="BtnControlPanel_Click"/>
                        </Grid>

                        <!-- 뷰 3: 최근 동기화/상태 로그 1줄 요약 & 로그 펼치기 -->
                        <Grid x:Name="DockViewLogSummary" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource ThemePanelBg}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="최근 로그" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeSubText}"/>
                            </Border>
                            <TextBlock x:Name="TxtDockLastLog" Grid.Column="1"
                                       Text="준비 완료"
                                       FontSize="11.5" Foreground="{DynamicResource ThemeText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Content="전체 로그" Style="{DynamicResource ThemeDockButtonStyle}" Margin="6,0,0,0" Click="BtnToggleLog_Click"/>
                        </Grid>
                    </Grid>

                    <!-- 우측 고정: 최소화 / 닫기 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource ThemeMinimizeButtonStyle}" ToolTip="트레이로 숨기기" Margin="4,0,2,0" Click="BtnHideToTray_Click"/>
                        <Button Style="{DynamicResource ThemeCloseButtonStyle}" ToolTip="종료" Click="BtnExit_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 숨김 호환 요소 (기존 롤링팁/타이틀 코드 호환용) -->
                <TextBlock x:Name="TxtTitleBar" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtRollingTicker" Visibility="Collapsed"/>
                <TextBlock x:Name="LblSubStatus" Visibility="Collapsed"/>

                <!-- 2행: 접이식 실시간 상태 로그 패널 -->
                <Border x:Name="LogPanelBorder" Visibility="Collapsed" Margin="0,8,0,2"
                        Background="{DynamicResource ThemeSurfaceBg}"
                        BorderBrush="{DynamicResource ThemePanelBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="6" Height="120">
                    <ListBox x:Name="LstLiveLog" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource ThemeText}"
                             FontSize="11" FontFamily="Consolas, Malgun Gothic"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
