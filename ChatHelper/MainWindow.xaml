<Window x:Class="ChatHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper" 
        Height="302" Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded">

    <!-- 윈도우 4단계 3D Raised 입체 프레임 -->
    <Border BorderThickness="1,1,0,0" BorderBrush="#FFFFFF">
        <Border BorderThickness="0,0,1,1" BorderBrush="#000000">
            <Border BorderThickness="1,1,0,0" BorderBrush="#DFDFDF">
                <Border BorderThickness="0,0,1,1" BorderBrush="#808080" Background="#C0C0C0" Padding="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 타이틀 바 -->
                        <Grid Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                <TextBlock Text="⌨" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI Emoji, Tahoma"/>
                                <TextBlock x:Name="TxtTitleBar" Text="ChatHelper - 실행 중" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" FontFamily="Tahoma, Gulim, Segoe UI"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                                <Button Style="{DynamicResource ThemeMinimizeButtonStyle}" ToolTip="트레이로 숨기기 (_)" Margin="0,0,3,0" Click="BtnHideToTray_Click"/>
                                <Button Style="{DynamicResource ThemeCloseButtonStyle}" ToolTip="프로그램 종료 (X)" Click="BtnExit_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- 본문 영역: 최상단 랜덤팁 -> 상단 동작여부/상태 -> 중간/하단 버튼 -->
                        <StackPanel Grid.Row="1" Margin="4,5,4,4">
                            <!-- 1. 최상단: 랜덤 템플릿 롤링 팝업 전광판 -->
                            <Border BorderThickness="1,1,0,0" BorderBrush="#808080" Margin="0,0,0,5">
                                <Border BorderThickness="0,0,1,1" BorderBrush="#FFFFFF">
                                    <Border Background="#FFFFE1" BorderThickness="1" BorderBrush="#A0A0A0" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💡 [랜덤 팁] " FontWeight="Bold" Foreground="#000080" FontSize="11" FontFamily="Tahoma, Gulim"/>
                                            <TextBlock x:Name="TxtRollingTicker" Text="템플릿 단축어 팁 로드 중..." Foreground="#111827" FontSize="11" FontFamily="Tahoma, Gulim" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Border>

                            <!-- 2. 상단: 상태 및 동작 여부 전광판 (Sunken 3D Bevel) -->
                            <Border BorderThickness="1,1,0,0" BorderBrush="#808080" Margin="0,0,0,5">
                                <Border BorderThickness="0,0,1,1" BorderBrush="#FFFFFF">
                                    <Border BorderThickness="1,1,0,0" BorderBrush="#000000">
                                        <Border BorderThickness="0,0,1,1" BorderBrush="#DFDFDF" Background="#D4D0C8" Padding="8,5">
                                            <StackPanel>
                                                <!-- 1행: 실행 상태 및 우측 상단 실시간 알림 배지 -->
                                                <Grid Margin="0,0,0,3">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#00A000" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock x:Name="LblRunningStatus" Text="자동완성 작동 중 (ON)" FontSize="12" FontWeight="Bold" Foreground="#000000" FontFamily="Tahoma, Gulim, Segoe UI" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- 우측 알림 배지 (갱신완료 / 업로드완료) -->
                                                    <Border x:Name="BadgeNotice" HorizontalAlignment="Right" Background="#006000" CornerRadius="2" Padding="6,1" VerticalAlignment="Center" Margin="0,0,1,0">
                                                        <TextBlock x:Name="TxtNotice" Text="✅ 갱신 완료!" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" FontFamily="Tahoma, Gulim"/>
                                                    </Border>
                                                </Grid>

                                                <!-- 2행: 시트 동기화 시각 (클릭 시 즉시 동기화) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock x:Name="LblSyncStatus" Text="🔄 시트: 11:25 (74개)" FontSize="11" Foreground="#004080" FontFamily="Tahoma, Gulim" Cursor="Hand" ToolTip="클릭하면 지금 즉시 구글 시트에서 최신 데이터를 동기화합니다" MouseLeftButtonUp="LblSyncStatus_MouseLeftButtonUp"/>
                                                </StackPanel>

                                                <!-- 3행: 계정 정보 및 완성키 힌트 -->
                                                <TextBlock x:Name="LblSubStatus" Text="👤 taerin (VIP)   |   ⌨️ 완성키: \ + Tab" FontSize="10.5" Foreground="#333333" FontFamily="Tahoma, Gulim, Segoe UI" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                                <!-- 4행: 업무 프로필 원클릭 빠른 전환 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="🗂 업무 프로필:" FontSize="11" FontWeight="Bold" Foreground="#000080" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Tahoma, Gulim"/>
                                                    <ComboBox x:Name="CmbMainProfile" Grid.Column="1" Height="22" FontSize="11" VerticalContentAlignment="Center" SelectionChanged="CmbMainProfile_SelectionChanged"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>

                            <!-- 3. 중간/하단: 2열 버튼 그리드 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 1행: 빠른 검색(Alt+Q), 특수기호(Alt+X) -->
                                <Button Grid.Row="0" Grid.Column="0" Content="🔍 검색 (Alt+Q)" Style="{DynamicResource ThemeButtonStyle}" Height="28" FontSize="11.5" FontWeight="Bold" Margin="0,0,2,3" Click="BtnQuickSearch_Click"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="✨ 특수기호 (Alt+X)" Style="{DynamicResource ThemeButtonStyle}" Height="28" FontSize="11.5" FontWeight="Bold" Margin="2,0,0,3" Click="BtnSymbolPicker_Click"/>

                                <!-- 2행: 답변 시트 등록, 제어판 -->
                                <Button Grid.Row="1" Grid.Column="0" Content="➕ 답변 시트 등록" Style="{DynamicResource ThemeButtonStyle}" Height="28" FontSize="11" Margin="0,0,2,3" Click="BtnQuickAddTemplate_Click"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="💻 제어판" Style="{DynamicResource ThemeButtonStyle}" Height="28" FontSize="11" Margin="2,0,0,3" Click="BtnControlPanel_Click"/>

                                <!-- 3행: 일시정지, 트레이 이동 -->
                                <Button Grid.Row="2" Grid.Column="0" x:Name="BtnTogglePause" Content="⏸️ 일시정지" Style="{DynamicResource ThemeButtonStyle}" Height="28" FontSize="11" Margin="0,0,2,0" Click="BtnTogglePause_Click"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="🔽 트레이 이동" Style="{DynamicResource ThemeButtonStyle}" Height="28" FontSize="11" Margin="2,0,0,0" Click="BtnHideToTray_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>