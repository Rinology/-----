<Window x:Class="ChatHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper"
        Height="48" Width="624"
        WindowStyle="None"
        Background="{DynamicResource ThemeHudBg}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded">

    <Grid Margin="0">
        <!-- 모던 플로팅 HUD 도킹 바 -->
        <Border Background="{DynamicResource ThemeHudBg}"
                BorderBrush="{DynamicResource ThemeHudBorder}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="10,6"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <StackPanel>
                <!-- 1행: 초슬림 1줄 HUD 도킹 바 -->
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 상태 점 + ON/OFF 토글 -->
                    <Button x:Name="BtnTogglePause" Grid.Column="0" Style="{DynamicResource ThemeDockButtonStyle}"
                            Padding="6,3" Margin="0,0,6,0" ToolTip="클릭하여 자동완성 ON/OFF 전환" Click="BtnTogglePause_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LblRunningStatus" Text="ON" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" FontFamily="Malgun Gothic, Segoe UI"/>
                        </StackPanel>
                    </Button>

                    <!-- 업무 프로필 드롭다운 -->
                    <ComboBox x:Name="CmbMainProfile" Grid.Column="1" Width="92" Height="26" FontSize="11.5"
                              VerticalContentAlignment="Center" Margin="0,0,8,0"
                              ToolTip="업무 프로필(스프레드시트) 즉시 전환"
                              SelectionChanged="CmbMainProfile_SelectionChanged"/>

                    <!-- 세로 구분선 -->
                    <Border Grid.Column="2" Width="1" Height="18" Background="{DynamicResource ThemePanelBorder}" Margin="0,0,8,0"/>

                    <!-- 핵심 액션 툴바 (이모지 제거, 깔끔한 텍스트/기호) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="검색" Style="{DynamicResource ThemeDockButtonStyle}" ToolTip="템플릿 빠른 검색 (Alt+Q)" Click="BtnQuickSearch_Click"/>
                        <Button Content="기호" Style="{DynamicResource ThemeDockButtonStyle}" ToolTip="특수기호 입력 (Alt+X)" Click="BtnSymbolPicker_Click"/>
                        <Button Content="+ 등록" Style="{DynamicResource ThemeDockButtonStyle}" ToolTip="새 답변 시트 등록" Click="BtnQuickAddTemplate_Click"/>

                        <Border Width="1" Height="16" Background="{DynamicResource ThemePanelBorder}" Margin="4,0"/>

                        <TextBlock x:Name="LblSyncStatus" Text="↻ 0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeSubText}" VerticalAlignment="Center"
                                   Padding="6,4" Cursor="Hand"
                                   ToolTip="클릭하여 지금 즉시 구글 시트 동기화"
                                   MouseLeftButtonUp="LblSyncStatus_MouseLeftButtonUp"/>

                        <!-- 실시간 알림 배지 (갱신/저장/인식 표시) -->
                        <Border x:Name="BadgeNotice" Visibility="Collapsed" Background="#16A34A" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock x:Name="TxtNotice" Text="완료" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10.5" FontFamily="Malgun Gothic, Segoe UI"/>
                        </Border>
                    </StackPanel>

                    <!-- 우측: 로그 / 설정 / 최소화 / 닫기 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleLog" Content="로그" Style="{DynamicResource ThemeDockButtonStyle}" ToolTip="실시간 상태 로그 열기/닫기" Click="BtnToggleLog_Click"/>
                        <Button Content="설정" Style="{DynamicResource ThemeDockButtonStyle}" ToolTip="제어판 열기" Click="BtnControlPanel_Click"/>
                        <Button Style="{DynamicResource ThemeMinimizeButtonStyle}" ToolTip="트레이로 숨기기" Margin="4,0,2,0" Click="BtnHideToTray_Click"/>
                        <Button Style="{DynamicResource ThemeCloseButtonStyle}" ToolTip="종료" Click="BtnExit_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 숨김 호환 요소 (기존 롤링팁/타이틀 코드 호환용) -->
                <TextBlock x:Name="TxtTitleBar" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtRollingTicker" Visibility="Collapsed"/>
                <TextBlock x:Name="LblSubStatus" Visibility="Collapsed"/>

                <!-- 2행: 접이식 실시간 상태 로그 패널 -->
                <Border x:Name="LogPanelBorder" Visibility="Collapsed" Margin="0,8,0,2"
                        Background="{DynamicResource ThemeSurfaceBg}"
                        BorderBrush="{DynamicResource ThemePanelBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="6" Height="120">
                    <ListBox x:Name="LstLiveLog" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource ThemeText}"
                             FontSize="11" FontFamily="Consolas, Malgun Gothic"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
