<Window x:Class="ChatHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper v2.0 (실행 중)" 
        Height="116" Width="390"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        Background="#C0C0C0"
        BorderBrush="#FFFFFF"
        BorderThickness="2"
        Loaded="Window_Loaded">
    <Border BorderThickness="1" BorderBrush="#000000">
        <Border BorderThickness="1" BorderBrush="#808080">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 윈도우 98 타이틀 바 -->
                <Grid Background="{StaticResource Win98TitleGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock x:Name="TxtTitleBar" Text="🟢 ChatHelper v2.0 ME - 실행 중" Foreground="White" FontWeight="Bold" FontSize="11" FontFamily="Tahoma, Gulim"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                        <Button Content="_" Style="{StaticResource Win98CloseButtonStyle}" ToolTip="트레이로 숨기기" Margin="0,0,2,0" Click="BtnHideToTray_Click"/>
                        <Button Style="{StaticResource Win98CloseButtonStyle}" ToolTip="프로그램 종료" Click="BtnExit_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 상태 정보 표시 -->
                <Border Grid.Row="1" Margin="6,6,6,4" BorderThickness="1,1,0,0" BorderBrush="#808080" Background="#D4D0C8" Padding="6,4">
                    <Border BorderThickness="0,0,1,1" BorderBrush="#FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#00A000" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LblRunningStatus" Grid.Column="1" Text="자동완성 작동 중 (ON)  |  사용자: taerin" FontSize="11" FontWeight="Bold" Foreground="#000080" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- 액션 버튼 바 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6,2,6,6">
                    <Button Content="💻 제어판 열기" Style="{StaticResource Win98ButtonStyle}" Width="96" FontWeight="Bold" Margin="0,0,4,0" Click="BtnControlPanel_Click"/>
                    <Button Content="🔍 검색(Alt+Q)" Style="{StaticResource Win98ButtonStyle}" Width="88" Margin="0,0,4,0" Click="BtnQuickSearch_Click"/>
                    <Button x:Name="BtnTogglePause" Content="⏸️ 일시정지" Style="{StaticResource Win98ButtonStyle}" Width="82" Margin="0,0,4,0" Click="BtnTogglePause_Click"/>
                    <Button Content="🔽 트레이이동" Style="{StaticResource Win98ButtonStyle}" Width="86" Click="BtnHideToTray_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
