<Window x:Class="ChatHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper v2.0 (실행 중)" 
        Height="165" Width="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        Background="#C0C0C0"
        BorderBrush="#FFFFFF"
        BorderThickness="2"
        Loaded="Window_Loaded">
    <Border BorderThickness="1" BorderBrush="#000000">
        <Border BorderThickness="1" BorderBrush="#808080">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 윈도우 98 타이틀 바 -->
                <Grid Background="{StaticResource Win98TitleGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="TxtTitleBar" Text="🟢 ChatHelper v2.0 Millennium Edition - 실행 중" Foreground="White" FontWeight="Bold" FontSize="12" FontFamily="Tahoma, Gulim"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button Style="{StaticResource Win98MinimizeButtonStyle}" ToolTip="트레이로 숨기기 (_)" Margin="0,0,3,0" Click="BtnHideToTray_Click"/>
                        <Button Style="{StaticResource Win98CloseButtonStyle}" ToolTip="프로그램 종료 (X)" Click="BtnExit_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 상태 전광판 (2줄 구성) -->
                <Border Grid.Row="1" Margin="10,10,10,6" BorderThickness="1,1,0,0" BorderBrush="#808080" Background="#D4D0C8" Padding="12,8">
                    <Border BorderThickness="0,0,1,1" BorderBrush="#FFFFFF">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#00A000" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="LblRunningStatus" Text="자동완성 작동 중 (ON)" FontSize="14" FontWeight="Bold" Foreground="#000080" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="LblSubStatus" Text="👤 계정: taerin (VIP / D-42일)   |   📋 템플릿: 50개   |   ⌨️ 완성키: \ + Tab" FontSize="11.5" Foreground="#202020"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- 하단 큼직한 액션 버튼 4개 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,4,10,10">
                    <Button Content="💻 제어판 열기" Style="{StaticResource Win98ButtonStyle}" Width="110" Height="32" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" Click="BtnControlPanel_Click"/>
                    <Button Content="🔍 검색 (Alt+Q)" Style="{StaticResource Win98ButtonStyle}" Width="110" Height="32" FontSize="12" Margin="0,0,6,0" Click="BtnQuickSearch_Click"/>
                    <Button x:Name="BtnTogglePause" Content="⏸️ 일시정지" Style="{StaticResource Win98ButtonStyle}" Width="104" Height="32" FontSize="12" Margin="0,0,6,0" Click="BtnTogglePause_Click"/>
                    <Button Content="🔽 트레이 이동" Style="{StaticResource Win98ButtonStyle}" Width="108" Height="32" FontSize="12" Click="BtnHideToTray_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
