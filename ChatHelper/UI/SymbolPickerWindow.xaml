<Window x:Class="ChatHelper.UI.SymbolPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="특수기호 빠른 입력 (Alt+X)"
        Width="456" Height="326"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="8" CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
            Background="{DynamicResource ThemeBg}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.16" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 타이틀 바 -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <TextBlock Text="특수기호 (Alt+X)" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="12.5" FontFamily="Malgun Gothic, Segoe UI" VerticalAlignment="Center"/>
                    <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 안내 배너 -->
            <TextBlock Grid.Row="1" Margin="14,8,14,6"
                       Text="숫자 1~9 즉시입력  ·  방향키 + Enter  ·  클릭 입력  ·  Esc 닫기"
                       FontSize="11" Foreground="{DynamicResource ThemeSubText}" FontWeight="SemiBold" FontFamily="Malgun Gothic, Segoe UI"/>

            <!-- 특수기호 그리드 영역 -->
            <Border Grid.Row="2" Margin="12,0,12,8" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="8" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="SymbolWrapPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- 하단: 사용자 기호 직접 추가/삭제 바 -->
            <Grid Grid.Row="3" Margin="12,0,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtNewSymbol" Grid.Column="0" Height="28" Style="{DynamicResource ThemeTextBoxStyle}"
                         FontSize="13" VerticalContentAlignment="Center"
                         ToolTip="추가할 특수문자나 기호를 입력/붙여넣기 후 추가"
                         KeyDown="TxtNewSymbol_KeyDown"/>
                <Button Grid.Column="1" Content="+ 추가" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="10,0" Margin="6,0,0,0" Click="BtnAddSymbol_Click"/>
                <Button Grid.Column="2" Content="삭제" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="10,0" Margin="4,0,0,0" Click="BtnDeleteSelected_Click"/>
                <Button Grid.Column="3" Content="기본값" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="10,0" Margin="4,0,0,0" ToolTip="기본 특수문자 목록으로 복원" Click="BtnResetSymbols_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
