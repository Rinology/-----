<Window x:Class="ChatHelper.UI.ConsultationMemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xenie"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeBg}"
        Width="900" Height="760"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border x:Name="MainWindowBorder" Margin="0" CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
            Background="{DynamicResource ThemeBg}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- 1. 타이틀 바 -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧩 Xenie · 답변 조합기" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="13" FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"/>
                        <TextBlock Text="열기(\+N)  ·  좁히기(Enter)  ·  최종입력(\+F)" Foreground="{DynamicResource ThemeSubText}" FontSize="11" Margin="10,2,0,0" FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnDockSticky" Content="🔗 임시메모 붙이기" Height="24" Padding="8,0" Margin="0,0,8,0"
                                FontSize="10.5" FontWeight="SemiBold" Background="{DynamicResource ThemeSurfaceBg}" Foreground="{DynamicResource ThemeAccentText}"
                                BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1" Cursor="Hand" Focusable="False"
                                ToolTip="챗헬프 임시메모 창을 옆에 자석처럼 붙이거나 분리합니다"
                                Click="BtnDockSticky_Click"/>
                        <Button Style="{DynamicResource ThemeCloseButtonStyle}" VerticalAlignment="Center" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 스무고개 키워드 입력 & 누적 칩 영역 -->
            <StackPanel Grid.Row="1" Margin="12,10,12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
                        <Grid Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtKeywordInput"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource ThemeText}"
                                     BorderThickness="0"
                                     Padding="12,4"
                                     FontSize="13"
                                     FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtKeywordInput_TextChanged"/>
                            <Button x:Name="BtnClearInput" Grid.Column="1" Content="✕"
                                    Width="24" Height="24" Margin="0,0,6,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource ThemeSubText}" Cursor="Hand"
                                    Click="BtnClearInput_Click" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="+ 키워드 좁히기 (Enter)"
                            Style="{DynamicResource ThemeButtonStyle}"
                            Margin="8,0,0,0" Padding="12,0" Height="34" FontSize="12" FontWeight="SemiBold"
                            ToolTip="입력한 키워드를 스무고개 조건 칩으로 추가하여 후보를 더 좁힙니다"
                            Click="BtnAddKeywordChip_Click"/>

                    <Button Grid.Column="2" Content="조건 초기화"
                            Margin="6,0,0,0" Padding="10,0" Height="34" FontSize="12"
                            Background="{DynamicResource ThemeSurfaceBg}"
                            Foreground="{DynamicResource ThemeSubText}"
                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                            Cursor="Hand"
                            Click="BtnResetChips_Click"/>
                </Grid>

                <!-- 누적된 스무고개 키워드 칩 바 -->
                <WrapPanel x:Name="KeywordChipsPanel" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- 3. 중앙 2단 영역 (좌: 스무고개 DB 후보 / 우: 달아둔 상담 메모 보드) -->
            <Grid Grid.Row="2" Margin="12,2,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측: 스무고개 DB 후보 -->
                <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtCandidateHint" Grid.Row="0" Margin="4,0,4,6"
                                   Text="🔍 키워드 · 제목 · 본문 문장으로 검색해 후보를 좁히세요 (0건)"
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSubText}" FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"/>

                        <ListBox x:Name="LstCandidates" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="LstCandidates_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="CandBorder"
                                                        Background="{DynamicResource ThemeBg}"
                                                        BorderBrush="{DynamicResource ThemePanelBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="10,7">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CandBorder" Property="Background" Value="#F8FAFC"/>
                                                        <Setter TargetName="CandBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="CandBorder" Property="Background" Value="#EFF6FF"/>
                                                        <Setter TargetName="CandBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Keyword}" Foreground="{DynamicResource ThemeAccentText}" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource ThemePanelBg}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource ThemeSubText}" FontSize="10.5"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource ThemeText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="3" Content="+ 담기" Padding="8,2" FontSize="11" FontWeight="SemiBold"
                                                Background="#ECFDF5" Foreground="#065F46" BorderBrush="#6EE7B7" BorderThickness="1"
                                                Cursor="Hand" Tag="{Binding}" Click="BtnAddCandidateToMemo_Click"/>

                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Content}" Foreground="{DynamicResource ThemeSubText}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="2" Content="+ 검색창에 적은 문구 그대로 추가"
                                Margin="0,6,0,0" Padding="10,6" FontSize="11.5" FontWeight="SemiBold"
                                Background="#F8FAFC" Foreground="{DynamicResource ThemeText}"
                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                Cursor="Hand"
                                Click="BtnAddCustomMemo_Click"/>
                    </Grid>
                </Border>

                <!-- 우측: 상담 중 달아둔 메모 보드 -->
                <Border Grid.Column="2" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,6">
                            <TextBlock x:Name="TxtMemoCount" Text="📌 달아둔 상담 메모 (0개)"
                                       FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                            <Button Content="전체 비우기" HorizontalAlignment="Right" Padding="8,2" FontSize="11"
                                    Background="Transparent" Foreground="#B91C1C" BorderBrush="#FECACA" BorderThickness="1"
                                    Cursor="Hand" Click="BtnClearMemos_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MemoEntriesPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. 최종 완성 텍스트 미리보기 -->
            <Border Grid.Row="3" Margin="12,0,12,4" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="✨ 최종 완성 문장 미리보기" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"
                                       ToolTip="미리보기 내용을 직접 수정한 뒤 입력할 수도 있습니다"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="↩ 되돌리기" Height="26" Padding="7,0" Margin="0,0,4,0" FontSize="11"
                                    Background="{DynamicResource ThemeBg}" Foreground="{DynamicResource ThemeAccentText}"
                                    BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1" Cursor="Hand"
                                    ToolTip="직접 수정한 내용을 원래 조합된 문장으로 되돌립니다"
                                    Click="BtnRestorePreview_Click"/>
                            <Button Content="🧹 비우기" Height="26" Padding="7,0" Margin="0,0,6,0" FontSize="11"
                                    Background="Transparent" Foreground="#B91C1C"
                                    BorderBrush="#FECACA" BorderThickness="1" Cursor="Hand"
                                    ToolTip="미리보기 내용만 비웁니다 (담아둔 메모는 유지)"
                                    Click="BtnClearPreview_Click"/>
                            <TextBlock Text="연결:" FontSize="11" Foreground="{DynamicResource ThemeSubText}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="CmbJoinMode" Width="132" Height="26" FontSize="11" VerticalContentAlignment="Center" SelectionChanged="CmbJoinMode_SelectionChanged">
                                <ComboBoxItem Content="문단 구분 (빈 줄)" Tag="Paragraph" IsSelected="True"/>
                                <ComboBoxItem Content="줄바꿈으로 연결" Tag="LineBreak"/>
                                <ComboBoxItem Content="번호 매기기 (1. 2. 3.)" Tag="Numbered"/>
                                <ComboBoxItem Content="불릿 목록 (•)" Tag="Bulleted"/>
                            </ComboBox>
                            <CheckBox x:Name="ChkConsumeStickyMemos" Content="사용한 임시메모 삭제" IsChecked="True" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                      ToolTip="완성 입력 시 변수에 사용된 임시메모 카드를 자동으로 삭제하고 남은 다음 변수로 이어서 채웁니다"/>
                            <CheckBox x:Name="ChkClearAfterInsert" Content="입력 후 조합칸 비우기" IsChecked="False" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                      ToolTip="체크 시 입력 후 우측 조합 목록을 모두 비웁니다 (여러 송장을 연속 입력할 때는 체크 해제 권장)"/>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="TxtFinalPreview"
                             Height="175"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="12.5"
                             FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"
                             Padding="8,6"
                             Background="{DynamicResource ThemeBg}"
                             Foreground="{DynamicResource ThemeText}"
                             BorderBrush="{DynamicResource ThemePanelBorder}"
                             BorderThickness="1"/>

                    <!-- 변수 전용 입력 바 ({송장번호}, {날짜} 등 감지 시 자동 표시) -->
                    <Border x:Name="VariableInputsBar" Visibility="Collapsed"
                            Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6"
                            Padding="8,6" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="변수 입력  ·  클립보드(📋)  ·  메모 카드 드래그"
                                       FontSize="11" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,5"/>
                            <WrapPanel x:Name="VariableInputsPanel" Orientation="Horizontal"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. 하단 액션 바 -->
            <Grid Grid.Row="4" Margin="14,0,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock VerticalAlignment="Center"
                           Text="후보이동(↑/↓) · 좁히기/담기(Enter) · 최종입력(\+F / Ctrl+Shift+Enter) · 닫기(Esc)"
                           Foreground="{DynamicResource ThemeSubText}" FontSize="11" FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📋 전체 복사"
                            Padding="12,5" FontSize="11.5" Margin="0,0,6,0"
                            Background="{DynamicResource ThemeSurfaceBg}" Foreground="{DynamicResource ThemeText}"
                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Cursor="Hand"
                            Click="BtnCopyFinal_Click"/>
                    <Button Content="✅ 최종 완성 입력"
                            Style="{DynamicResource ThemeButtonStyle}"
                            Padding="14,5" FontSize="12" FontWeight="Bold"
                            Click="BtnInsertFinal_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
