<Window x:Class="ChatHelper.UI.QuickAiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="680" Height="460"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 윈도우 98 정통 4단계 3D Raised 입체 베벨 외곽 프레임 -->
    <Border BorderThickness="1,1,0,0" BorderBrush="#FFFFFF">
        <Border BorderThickness="0,0,1,1" BorderBrush="#000000">
            <Border BorderThickness="1,1,0,0" BorderBrush="#DFDFDF">
                <Border BorderThickness="0,0,1,1" BorderBrush="#808080" Background="#C0C0C0" Padding="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <!-- 1. 타이틀 바 -->
                        <Grid Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="🤖" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI Emoji, Tahoma"/>
                                <TextBlock Text="ChatHelper 로컬 AI 상담 비서" 
                                           Foreground="#FFFFFF" 
                                           FontWeight="Bold" FontSize="12" 
                                           FontFamily="Tahoma, Gulim, Segoe UI"/>
                                <TextBlock Text="[단축키: Alt+X  |  캡처 이미지/텍스트 자동 분석]" 
                                           Foreground="#C0D8F8" 
                                           FontSize="11" Margin="8,1,0,0"
                                           FontFamily="Tahoma, Gulim, Segoe UI"/>
                            </StackPanel>
                            <Button Style="{DynamicResource ThemeCloseButtonStyle}" 
                                    HorizontalAlignment="Right" 
                                    Margin="0,0,3,0" 
                                    Click="BtnClose_Click"/>
                        </Grid>

                        <!-- 2. 고객 문의 / 캡처 OCR 영역 -->
                        <GroupBox Grid.Row="1" Header="고객 문의 내용 (클립보드 / 캡처 OCR)" Margin="5,5,5,2" FontFamily="Tahoma, Gulim">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="65"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock x:Name="TxtSourceType" Text="[인식: 복사된 텍스트]" FontWeight="Bold" Foreground="#000080" FontSize="11"/>
                                    <TextBlock Text=" (내용을 직접 수정하거나 다시 입력할 수 있습니다)" Foreground="#606060" FontSize="11" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBox x:Name="TxtCustomerInput" Grid.Row="1" 
                                         TextWrapping="Wrap" AcceptsReturn="True" 
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="12" FontFamily="Malgun Gothic, Segoe UI"
                                         Background="#FFFFFF" Foreground="#000000"
                                         BorderBrush="#808080" BorderThickness="1"
                                         Padding="4"/>
                            </Grid>
                        </GroupBox>

                        <!-- 3. AI 추천 답변 및 시트 알약 제안 영역 -->
                        <GroupBox Grid.Row="2" Header="💡 추천 CS 답변 &amp; 시트 알약 제안 (친절하고 정중한 한국어 존댓말)" Margin="5,2,5,2" FontFamily="Tahoma, Gulim">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <WrapPanel x:Name="PnlSuggestedPills" Grid.Row="0" Margin="0,0,0,4" Visibility="Collapsed"/>
                                <TextBox x:Name="TxtAiResponse" Grid.Row="1"
                                         TextWrapping="Wrap" AcceptsReturn="True" 
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="13" FontFamily="Malgun Gothic, Segoe UI"
                                         Background="#FFFFF0" Foreground="#000000"
                                         BorderBrush="#808080" BorderThickness="1"
                                         FontWeight="Medium"
                                         Padding="6"/>
                                <!-- 로딩 오버레이 -->
                                <Border x:Name="PnlLoading" Grid.Row="1" Background="#C0FFFFFF" Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="⚡ 로컬 AI가 친절한 답변을 작성 중입니다..." 
                                                   FontWeight="Bold" FontSize="13" Foreground="#000080" 
                                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <ProgressBar IsIndeterminate="True" Width="240" Height="14"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <!-- 4. 상태 메시지 -->
                        <TextBlock x:Name="TxtStatus" Grid.Row="3" 
                                   Text="준비 완료" Foreground="#404040" FontSize="11" 
                                   Margin="8,2,8,2" FontFamily="Tahoma, Gulim"/>

                        <!-- 5. 하단 버튼 바 -->
                        <Grid Grid.Row="4" Background="#D4D0C8" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="조작: [Tab] 대화창 바로 입력  |  [Enter] 입력+전송  |  [F5] 다시 작성  |  [Esc] 닫기" 
                                           FontSize="11" Foreground="#505050" FontFamily="Tahoma, Gulim"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Button x:Name="BtnSaveToSheet" Content="💾 시트 저장" 
                                        Width="88" Height="25" Margin="0,0,5,0"
                                        Style="{DynamicResource ThemeWin98Button}" Click="BtnSaveToSheet_Click"/>
                                <Button x:Name="BtnRegenerate" Content="🔄 다시작성(F5)" 
                                        Width="95" Height="25" Margin="0,0,5,0"
                                        Style="{DynamicResource ThemeWin98Button}" Click="BtnRegenerate_Click"/>
                                <Button x:Name="BtnInject" Content="✔ 대화창 입력(Tab)" 
                                        Width="115" Height="25" Margin="0,0,5,0"
                                        FontWeight="Bold"
                                        Style="{DynamicResource ThemeWin98Button}" Click="BtnInject_Click"/>
                                <Button x:Name="BtnClose" Content="닫기(Esc)" 
                                        Width="70" Height="25"
                                        Style="{DynamicResource ThemeWin98Button}" Click="BtnClose_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
