<Window x:Class="ChatHelper.UI.StickyMemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGENIE"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FFFDF8"
        Width="430" Height="760"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded">

    <Border x:Name="MainBorder"
            Margin="0"
            CornerRadius="10"
            Background="#FFFDF8"
            BorderBrush="#E8D284"
            BorderThickness="1.5"
            MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 헤더 (ChatGENIE + 로딩 표시 + 통일된 붙여넣기/지우기 버튼) -->
            <Border x:Name="HeaderBorder" Grid.Row="0" Background="#FEF9E7" BorderBrush="#F3E5AB" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Cursor="SizeAll">
                <Grid Margin="12,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtMemoHeader" Text="ChatGENIE (0)"
                                   Foreground="#854D0E" FontWeight="Bold" FontSize="13" FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy" VerticalAlignment="Center"/>
                        <Border x:Name="LoadingBadge" Visibility="Collapsed" Margin="8,0,0,0" Padding="6,2"
                                Background="#FFFFFF" BorderBrush="#E8D284" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtLoadingIcon" Text="⏳" FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock Text="인식중" FontSize="10" FontWeight="SemiBold" Foreground="#A16207" Margin="3,0,0,0" VerticalAlignment="Center"
                                           FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnPasteClip" Content="📋 붙여넣기" Height="26" Margin="0,0,4,0" Padding="8,0"
                                FontSize="11" FontWeight="SemiBold" Background="#FFFFFF" Foreground="#854D0E" BorderBrush="#E8D284" BorderThickness="1"
                                Cursor="Hand" Focusable="False" ToolTip="클립보드/OCR 붙여넣기(\+V)"
                                FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"
                                Click="BtnPasteClip_Click"/>
                        <Button x:Name="BtnClearAll" Content="🧹 지우기" Height="26" Margin="0,0,4,0" Padding="8,0"
                                FontSize="11" FontWeight="SemiBold" Background="#FFFFFF" Foreground="#854D0E" BorderBrush="#E8D284" BorderThickness="1"
                                Cursor="Hand" Focusable="False" ToolTip="전체 비우기(\+C)"
                                FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"
                                Click="BtnClearAll_Click"/>
                        <Button x:Name="BtnClose" Content="✕" Width="30" Height="28" Padding="0"
                                FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="#854D0E" BorderThickness="0"
                                Cursor="Hand" Focusable="False" ToolTip="닫기(Alt+N)"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 빠른 직접 메모 입력 줄 + 날짜 드롭다운 -->
            <Grid Grid.Row="1" Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtQuickMemo" Grid.Column="0" Height="28" FontSize="11.5" Padding="7,3"
                         VerticalContentAlignment="Center" Background="#FFFFFF" Foreground="#1E293B"
                         BorderBrush="#E8D284" BorderThickness="1"
                         ToolTip="송장번호나 메모를 직접 입력하고 Enter로 추가하세요"
                         PreviewMouseDown="TxtQuickMemo_PreviewMouseDown"
                         KeyDown="TxtQuickMemo_KeyDown"/>
                <Button x:Name="BtnAddQuickMemo" Grid.Column="1" Content="+ 추가" Height="28" Padding="9,0" Margin="5,0,0,0"
                        FontSize="11" FontWeight="Bold" Background="#FEF3C7" Foreground="#854D0E"
                        BorderBrush="#E8D284" BorderThickness="1" Cursor="Hand" Focusable="False"
                        Click="BtnAddQuickMemo_Click"/>
                <ComboBox x:Name="CmbDatePreset" Grid.Column="2" Width="96" Height="28" Margin="5,0,0,0"
                          FontSize="11" Background="#FFFFFF" Foreground="#854D0E" BorderBrush="#E8D284" BorderThickness="1"
                          VerticalContentAlignment="Center" Focusable="False" SelectedIndex="0"
                          ToolTip="빠른 날짜 선택"
                          SelectionChanged="CmbDatePreset_SelectionChanged">
                    <ComboBoxItem Content="📅 날짜" Tag=""/>
                    <ComboBoxItem Content="📅 오늘" Tag="Today"/>
                    <ComboBoxItem Content="📅 내일" Tag="Tomorrow"/>
                    <ComboBoxItem Content="🕒 금일 오후" Tag="TodayPm"/>
                    <ComboBoxItem Content="🕒 내일 오전" Tag="TomorrowAm"/>
                </ComboBox>
            </Grid>

            <!-- 3. 메모 카드 목록 (드래그 앤 드롭 지원) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,4,8,4">
                <StackPanel x:Name="MemoCardsPanel"/>
            </ScrollViewer>

            <!-- 4. 하단 2줄 단축키 안내 바 -->
            <Border x:Name="FooterBorder" Grid.Row="3" Background="#FEF9E7" BorderBrush="#F3E5AB" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9" Padding="10,7">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="TxtFooterLine1" Text="열기/닫기(Alt+N)  ·  단어담기(\+M)"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="#854D0E" FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"/>
                    <TextBlock x:Name="TxtFooterLine2" Text="클립보드(\+V)  ·  비우기(\+C)"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="#854D0E" Margin="0,3,0,0" FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
