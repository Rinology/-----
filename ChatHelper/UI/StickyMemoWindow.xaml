<Window x:Class="ChatHelper.UI.StickyMemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGENIE 임시메모"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FFFDF5"
        Width="360" Height="760"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded">

    <Border x:Name="MainBorder"
            Margin="0"
            CornerRadius="10"
            Background="#FFFDF5"
            BorderBrush="#F59E0B"
            BorderThickness="1.5"
            MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 포스트잇 헤더 -->
            <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Cursor="SizeAll">
                <Grid Margin="10,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtMemoHeader" Text="📌 ChatGENIE 임시메모 (0)"
                                   Foreground="#92400E" FontWeight="Bold" FontSize="12.5" FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📋" Width="28" Height="26" Margin="0,0,3,0" Padding="0"
                                FontSize="12" Background="#FFFFFF" Foreground="#92400E" BorderBrush="#FCD34D" BorderThickness="1"
                                Cursor="Hand" Focusable="False" ToolTip="클립보드(\+V)"
                                Click="BtnPasteClip_Click"/>
                        <Button Content="🧩 Xenie" Height="26" Margin="0,0,3,0" Padding="8,0"
                                FontSize="11" FontWeight="Bold" Background="#FFFFFF" Foreground="#1E3A8A" BorderBrush="#93C5FD" BorderThickness="1"
                                Cursor="Hand" Focusable="False" ToolTip="스무고개 조합기(\+N)"
                                Click="BtnOpenCombiner_Click"/>
                        <Button Content="🧹" Width="26" Height="26" Margin="0,0,2,0" Padding="0"
                                FontSize="12" Background="Transparent" Foreground="#B45309" BorderThickness="0"
                                Cursor="Hand" Focusable="False" ToolTip="비우기(\+C)"
                                Click="BtnClearAll_Click"/>
                        <Button Content="✕" Width="32" Height="30" Padding="0"
                                FontSize="14" FontWeight="Bold" Background="Transparent" Foreground="#78350F" BorderThickness="0"
                                Cursor="Hand" Focusable="False" ToolTip="닫기(Alt+N)"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 빠른 직접 메모 입력 줄 + 기본 날짜 프리셋 -->
            <StackPanel Grid.Row="1" Margin="8,8,8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtQuickMemo" Grid.Column="0" Height="28" FontSize="11.5" Padding="7,3"
                             VerticalContentAlignment="Center" Background="#FFFFFF" Foreground="#1E293B"
                             BorderBrush="#FCD34D" BorderThickness="1"
                             ToolTip="송장번호나 메모를 직접 입력하고 Enter로 추가하세요"
                             PreviewMouseDown="TxtQuickMemo_PreviewMouseDown"
                             KeyDown="TxtQuickMemo_KeyDown"/>
                    <Button Grid.Column="1" Content="+ 추가" Height="28" Padding="9,0" Margin="5,0,0,0"
                            FontSize="11" FontWeight="Bold" Background="#FDE68A" Foreground="#78350F"
                            BorderBrush="#F59E0B" BorderThickness="1" Cursor="Hand" Focusable="False"
                            Click="BtnAddQuickMemo_Click"/>
                </Grid>
                <WrapPanel Margin="0,5,0,0">
                    <Button Content="📅 오늘" Tag="Today" Height="22" Padding="7,0" Margin="0,0,4,0" FontSize="10.5"
                            Background="#FFFFFF" Foreground="#92400E" BorderBrush="#FCD34D" BorderThickness="1"
                            Cursor="Hand" Focusable="False" Click="BtnDatePreset_Click"/>
                    <Button Content="📅 내일" Tag="Tomorrow" Height="22" Padding="7,0" Margin="0,0,4,0" FontSize="10.5"
                            Background="#FFFFFF" Foreground="#92400E" BorderBrush="#FCD34D" BorderThickness="1"
                            Cursor="Hand" Focusable="False" Click="BtnDatePreset_Click"/>
                    <Button Content="🕒 금일 오후" Tag="TodayPm" Height="22" Padding="7,0" Margin="0,0,4,0" FontSize="10.5"
                            Background="#FFFFFF" Foreground="#92400E" BorderBrush="#FCD34D" BorderThickness="1"
                            Cursor="Hand" Focusable="False" Click="BtnDatePreset_Click"/>
                    <Button Content="🕒 내일 오전" Tag="TomorrowAm" Height="22" Padding="7,0" FontSize="10.5"
                            Background="#FFFFFF" Foreground="#92400E" BorderBrush="#FCD34D" BorderThickness="1"
                            Cursor="Hand" Focusable="False" Click="BtnDatePreset_Click"/>
                </WrapPanel>
            </StackPanel>

            <!-- 3. 메모 카드 목록 (드래그 앤 드롭 지원) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,4,8,4">
                <StackPanel x:Name="MemoCardsPanel"/>
            </ScrollViewer>

            <!-- 4. 하단 2줄 단축키 안내 바 -->
            <Border Grid.Row="3" Background="#FEF9C3" BorderBrush="#FDE68A" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9" Padding="10,7">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="열기/닫기(Alt+N)  ·  단어담기(\+M)"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="#92400E" FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"/>
                    <TextBlock Text="클립보드(\+V)  ·  비우기(\+C)  ·  조합기(\+N)"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="#92400E" Margin="0,3,0,0" FontFamily="pack://application:,,,/ChatGENIE;component/Assets/Fonts/#Paperlogy"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
