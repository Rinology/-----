<Window x:Class="ChatHelper.UI.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="740" Height="520"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="MainBorder" 
            Background="{DynamicResource ThemeBg}" 
            BorderBrush="{DynamicResource ThemeAccent}" 
            BorderThickness="2" 
            CornerRadius="8" 
            Padding="12"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- 1. 타이틀 바 -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍 CS 템플릿 빠른 검색 및 추천" 
                               Foreground="{DynamicResource ThemeText}" 
                               FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="(단축키: Alt+Q)" 
                               Foreground="{DynamicResource ThemeSubText}" 
                               FontSize="12" Margin="8,2,0,0"/>
                </StackPanel>
                <Button Content="✕" 
                        HorizontalAlignment="Right" 
                        Width="28" Height="26" 
                        Style="{DynamicResource ThemeCloseButtonStyle}" 
                        Click="BtnClose_Click"/>
            </Grid>

            <!-- 2. 검색창 -->
            <Border Grid.Row="1" Margin="0,8,0,8" 
                    Background="{DynamicResource ThemeSurfaceBg}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔎" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                    <TextBox x:Name="TxtSearch" 
                             Grid.Column="1"
                             Height="38" 
                             Background="Transparent" 
                             Foreground="{DynamicResource ThemeText}" 
                             BorderThickness="0" 
                             Padding="6,4" 
                             FontSize="14" 
                             VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" 
                            Width="28" Height="28" Margin="0,0,6,0" 
                            Background="Transparent" BorderThickness="0" 
                            Foreground="{DynamicResource ThemeSubText}" Cursor="Hand" 
                            Click="BtnClearSearch_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 3. 카테고리 필터 칩 바 -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                <StackPanel x:Name="CategoryPanel" Orientation="Horizontal">
                    <!-- 카테고리 칩들이 동적으로 여기에 추가됨 -->
                </StackPanel>
            </ScrollViewer>

            <!-- 4. 템플릿 목록 -->
            <Border Grid.Row="3" Background="{DynamicResource ThemeSurfaceBg}" 
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6">
                <ListBox x:Name="LstTemplates" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="LstTemplates_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemBorder" Background="{DynamicResource ThemeBg}" CornerRadius="6" Padding="10,8" Margin="2,3" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 단축키 배지 -->
                                    <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Keyword}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>

                                    <!-- 카테고리 태그 -->
                                    <Border Grid.Column="1" Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Category}" Foreground="#3730A3" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>

                                    <!-- 제목 -->
                                    <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource ThemeText}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>

                                    <!-- 내용 미리보기 -->
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Content}" Foreground="{DynamicResource ThemeSubText}" FontSize="12" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 5. 하단 액션 툴바 -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <TextBlock VerticalAlignment="Center" 
                           Text="↵ Enter: 이전 창에 입력  |  ↑/↓: 항목 이동  |  Esc: 닫기" 
                           Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="➕ 새 템플릿 등록 및 시트 업로드" 
                            Style="{DynamicResource ThemeButtonStyle}" 
                            Padding="12,5" FontSize="12"
                            Click="BtnAddAndUpload_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
