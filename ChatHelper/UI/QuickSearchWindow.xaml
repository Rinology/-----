<Window x:Class="ChatHelper.UI.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="760" Height="540"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="MainBorder" 
            Background="{DynamicResource ThemeBg}" 
            BorderBrush="{DynamicResource ThemeBorder}" 
            BorderThickness="{DynamicResource ThemeWindowBorderThickness}" 
            CornerRadius="{DynamicResource ThemeWindowCornerRadius}" 
            Padding="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- 1. 타이틀 바 (마우스 드래그 이동 지원) -->
            <Grid Grid.Row="0" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍 템플릿 빠른 검색 및 추천" 
                               Foreground="{DynamicResource ThemeText}" 
                               FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="(단축키: Alt+Q  |  Tab: 목록/카테고리 이동)" 
                               Foreground="{DynamicResource ThemeSubText}" 
                               FontSize="12" Margin="10,2,0,0"/>
                </StackPanel>
                <Button Content="✕" 
                        HorizontalAlignment="Right" 
                        Width="30" Height="28" 
                        Cursor="Arrow"
                        Style="{DynamicResource ThemeCloseButtonStyle}" 
                        Click="BtnClose_Click"/>
            </Grid>

            <!-- 2. 검색창 -->
            <Border Grid.Row="1" Margin="0,10,0,8" 
                    Background="{DynamicResource ThemeSurfaceBg}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔎" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                    <TextBox x:Name="TxtSearch" 
                             Grid.Column="1"
                             Height="40" 
                             Background="Transparent" 
                             Foreground="{DynamicResource ThemeText}" 
                             BorderThickness="0" 
                             Padding="6,4" 
                             FontSize="15" 
                             VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" 
                            Width="30" Height="30" Margin="0,0,8,0" 
                            Background="Transparent" BorderThickness="0" 
                            Foreground="{DynamicResource ThemeSubText}" Cursor="Hand" 
                            Click="BtnClearSearch_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 3. 카테고리 필터 칩 바 -->
            <ScrollViewer x:Name="CategoryScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                <StackPanel x:Name="CategoryPanel" Orientation="Horizontal">
                    <!-- 카테고리 칩들이 동적으로 여기에 추가됨 -->
                </StackPanel>
            </ScrollViewer>

            <!-- 4. 결과 상태 안내 (스마트 폴백 알림) -->
            <TextBlock x:Name="TxtResultHint" Grid.Row="3" Margin="4,0,0,6" 
                       Text="총 0개의 템플릿이 로드되었습니다." 
                       FontSize="12" Foreground="{DynamicResource ThemeSubText}"/>

            <!-- 5. 템플릿 목록 -->
            <Border Grid.Row="4" Background="{DynamicResource ThemeSurfaceBg}" 
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6">
                <ListBox x:Name="LstTemplates" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="LstTemplates_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="2,3"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- 기본 흰색 배경 + 연한 테두리 -->
                                        <Border x:Name="ItemBorder" 
                                                Background="#FFFFFF" 
                                                BorderBrush="#D1D5DB" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="12,9">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- 마우스 오버 시 연한 회색 -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6"/>
                                            </Trigger>
                                            <!-- 선택된 항목만 그레이톤 배경 및 진한 테두리로 강조 -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#D8DCE3"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4B5563"/>
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#CFD5DE"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 단축키 배지 -->
                                <Border Background="#1E3A8A" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Keyword}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>

                                <!-- 카테고리 태그 -->
                                <Border Grid.Column="1" Background="#E0E7FF" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Category}" Foreground="#3730A3" FontWeight="SemiBold" FontSize="11"/>
                                </Border>

                                <!-- 제목 (검정색 기본 텍스트) -->
                                <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="#000000" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>

                                <!-- 내용 미리보기 (짙은 검정/회색 텍스트) -->
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Content}" Foreground="#374151" FontSize="12.5" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 6. 하단 액션 툴바 (드래그 이동 지원) -->
            <Grid Grid.Row="5" Background="Transparent" Margin="0,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock VerticalAlignment="Center" 
                           Text="↵ Enter: 이전 창에 입력  |  ↑/↓: 이동  |  Tab: 목록/검색 전환  |  Esc: 닫기" 
                           Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="➕ 새 템플릿 등록 및 시트 업로드" 
                            Style="{DynamicResource ThemeButtonStyle}" 
                            Padding="14,6" FontSize="12"
                            Click="BtnAddAndUpload_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
