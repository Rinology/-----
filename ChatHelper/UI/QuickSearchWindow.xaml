<Window x:Class="ChatHelper.UI.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="460" Height="320"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="Window_KeyDown">
    <Border Background="#18181B" 
            BorderBrush="#3F3F46" 
            BorderThickness="1" 
            CornerRadius="10" 
            Padding="10"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 검색 입력창 -->
            <TextBox x:Name="TxtSearch" 
                     Height="34" 
                     Background="#27272A" 
                     Foreground="#F4F4F5" 
                     BorderBrush="#52525B" 
                     Padding="8,4" 
                     FontSize="13" 
                     VerticalContentAlignment="Center"
                     TextChanged="TxtSearch_TextChanged"/>

            <!-- 목록 -->
            <ListBox x:Name="LstTemplates" 
                     Grid.Row="1" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     Margin="0,8,0,8" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="LstTemplates_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#27272A" CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Keyword, StringFormat='[{0}]'}" Foreground="#60A5FA" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#F4F4F5" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Content}" Foreground="#9CA3AF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 안내 라벨 -->
            <TextBlock Grid.Row="2" Text="↵ Enter: 입력  |  ↑/↓: 이동  |  Esc: 닫기" Foreground="#71717A" FontSize="11"/>
        </Grid>
    </Border>
</Window>
