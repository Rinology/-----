<Window x:Class="ChatHelper.UI.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeBg}"
        Width="744" Height="524"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="0" CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
            Background="{DynamicResource ThemeBg}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- 1. 타이틀 바 -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="템플릿 빠른 검색" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="13" FontFamily="Malgun Gothic, Segoe UI"/>
                        <TextBlock Text="Alt+S  ·  Tab: 카테고리 전환" Foreground="{DynamicResource ThemeSubText}" FontSize="11" Margin="10,2,0,0" FontFamily="Malgun Gothic, Segoe UI"/>
                    </StackPanel>
                    <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 2. 검색창 -->
            <Border Grid.Row="1" Margin="12,10,12,8" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSearch"
                             Grid.Column="0"
                             Background="Transparent"
                             Foreground="{DynamicResource ThemeText}"
                             BorderThickness="0"
                             Padding="12,4"
                             FontSize="13.5"
                             FontFamily="Malgun Gothic, Segoe UI"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <Button x:Name="BtnClearSearch" Grid.Column="1" Content="✕"
                            Width="24" Height="24" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource ThemeSubText}" Cursor="Hand"
                            Click="BtnClearSearch_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 3. 카테고리 필터 칩 바 -->
            <ScrollViewer x:Name="CategoryScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="12,0,12,6">
                <StackPanel x:Name="CategoryPanel" Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- 4. 결과 상태 안내 -->
            <TextBlock x:Name="TxtResultHint" Grid.Row="3" Margin="14,0,14,6"
                       Text="총 0개의 템플릿이 로드되었습니다."
                       FontSize="11.5" Foreground="{DynamicResource ThemeSubText}" FontFamily="Malgun Gothic, Segoe UI"/>

            <!-- 5. 템플릿 목록 -->
            <Border Grid.Row="4" Margin="12,0,12,4" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="8">
                <ListBox x:Name="LstTemplates"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="LstTemplates_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="2,3"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{DynamicResource ThemeSurfaceBg}"
                                                BorderBrush="{DynamicResource ThemePanelBorder}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="12,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,7,0">
                                    <TextBlock Text="{Binding Keyword}" Foreground="{DynamicResource ThemeAccentText}" FontWeight="SemiBold" FontSize="11.5" FontFamily="Malgun Gothic, Segoe UI"/>
                                </Border>

                                <Border Grid.Column="1" Background="{DynamicResource ThemePanelBg}" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource ThemeSubText}" FontWeight="SemiBold" FontSize="11" FontFamily="Malgun Gothic, Segoe UI"/>
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource ThemeText}" FontWeight="SemiBold" FontSize="13" FontFamily="Malgun Gothic, Segoe UI" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Content}" Foreground="{DynamicResource ThemeSubText}" FontSize="12" FontFamily="Malgun Gothic, Segoe UI" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 6. 하단 액션 바 -->
            <Grid Grid.Row="5" Margin="14,0,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock VerticalAlignment="Center"
                           Text="Enter 입력  ·  ↑/↓ 이동  ·  Tab 카테고리  ·  Esc 닫기"
                           Foreground="{DynamicResource ThemeSubText}" FontSize="11.5" FontFamily="Malgun Gothic, Segoe UI"/>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="+ 새 답변 시트 등록"
                        Style="{DynamicResource ThemeButtonStyle}"
                        Padding="12,5" FontSize="11.5"
                        Click="BtnAddAndUpload_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
