<Window x:Class="ChatHelper.UI.ExitConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="종료 확인"
        Width="380" Height="204"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource ThemeBg}"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="0"
            CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
            Background="{DynamicResource ThemeBg}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 타이틀 바 -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <TextBlock Text="ChatHelper 종료" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="12.5" FontFamily="Malgun Gothic, Segoe UI" VerticalAlignment="Center"/>
                    <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnCancel_Click"/>
                </Grid>
            </Border>

            <!-- 본문 안내 -->
            <StackPanel Grid.Row="1" Margin="20,16,20,10" VerticalAlignment="Center">
                <TextBlock Text="프로그램을 종료할까요?" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" FontFamily="Malgun Gothic, Segoe UI" Margin="0,0,0,6"/>
                <TextBlock Text="현재 아이디를 기억한 채 종료하거나, 아이디 기록을 지우고 종료할 수 있습니다."
                           FontSize="12" Foreground="{DynamicResource ThemeSubText}" TextWrapping="Wrap" FontFamily="Malgun Gothic, Segoe UI"/>
            </StackPanel>

            <!-- 하단 버튼 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,4,18,16">
                <Button Content="취소" Style="{DynamicResource ThemeButtonStyle}" Height="32" Padding="12,0" Margin="0,0,6,0" Click="BtnCancel_Click"/>
                <Button Content="아이디 지우고 종료" Style="{DynamicResource ThemeButtonStyle}" Height="32" Padding="12,0" Margin="0,0,6,0" Click="BtnLogoutExit_Click"/>
                <Button Content="종료" Style="{DynamicResource ThemeButtonStyle}"
                        Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="#FFFFFF"
                        Height="32" Padding="16,0" Click="BtnKeepExit_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
