<Window x:Class="ChatHelper.UI.ExitConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="종료 확인"
        Width="380" Height="204"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource ThemeBg}"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="0"
            CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
            Background="{DynamicResource ThemeBg}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 타이틀 바 -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <TextBlock Text="ChatHelper 종료" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="12.5" FontFamily="pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy" VerticalAlignment="Center"/>
                    <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnCancel_Click"/>
                </Grid>
            </Border>

            <!-- 본문 안내 -->
            <StackPanel Grid.Row="1" Margin="20,16,20,10" VerticalAlignment="Center">
                <TextBlock Text="ChatHelper를 종료할까요?" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" FontFamily="pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtExitDesc" Text="현재 아이디를 유지한 채 프로그램을 종료합니다. (종료 시 로그아웃 여부는 환경설정 상단에서 변경할 수 있습니다.)"
                           FontSize="12" Foreground="{DynamicResource ThemeSubText}" TextWrapping="Wrap" FontFamily="pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy"/>
            </StackPanel>

            <!-- 하단 버튼 (취소 / 종료 2개만 유지) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,4,18,16">
                <Button Content="취소" Style="{DynamicResource ThemeButtonStyle}" Height="32" Padding="14,0" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="종료" Style="{DynamicResource ThemeButtonStyle}"
                        Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccentBorder}" Foreground="{DynamicResource ThemeAccentText}"
                        Height="32" Padding="18,0" Click="BtnConfirmExit_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
