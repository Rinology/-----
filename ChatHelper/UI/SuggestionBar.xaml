<Window x:Class="ChatHelper.UI.SuggestionBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded">
    <Border x:Name="MainBorder" 
            CornerRadius="0" 
            Background="#FFFFE1" 
            BorderBrush="#000000" 
            BorderThickness="1" 
            Padding="6,3">
        <Border.Effect>
            <!-- 윈도우 98 클래식 하드 그림자 (블러 0, 정밀한 2px 오프셋) -->
            <DropShadowEffect BlurRadius="0" Direction="315" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel Orientation="Vertical">
            <Border x:Name="RecognitionHeaderBorder" Background="#E5E7EB" BorderBrush="#9CA3AF" BorderThickness="0,0,0,1" Padding="6,2" Margin="0,0,0,4" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtRecognitionHeader" Grid.Column="0" Text="🔎 인식됨: " FontSize="11" FontWeight="Bold" Foreground="#1F2937" FontFamily="Tahoma, Gulim, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtAutoHideCountdown" Grid.Column="1" Text="⏱ 12s" FontSize="10.5" FontWeight="SemiBold" Foreground="#4B5563" FontFamily="Tahoma, Gulim" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="BtnQuickRegisterToken" Grid.Column="2" Content="➕ 시트 등록"
                            FontSize="10.5" FontWeight="Bold" Padding="6,1" Cursor="Hand" Focusable="False"
                            Background="#000080" Foreground="#FFFFFF" BorderBrush="#000000" BorderThickness="1"
                            ToolTip="현재 인식된 단어를 단축어로 하여 구글 시트에 새 답변을 바로 등록합니다"
                            Click="BtnQuickRegisterToken_Click"/>
                </Grid>
            </Border>
            <StackPanel x:Name="TopAiRowPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5" Visibility="Collapsed">
                <!-- 🤖 AI 추천 상단 배치 라인 -->
            </StackPanel>
            <WrapPanel x:Name="ItemsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 시트 추천 칩 아이템들이 동적으로 여기에 추가됨 (화면 초과 시 자동 줄바꿈) -->
            </WrapPanel>
            <StackPanel x:Name="BottomAiRowPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0" Visibility="Collapsed">
                <!-- 🤖 AI 추천 하단 배치 라인 -->
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
