<Window x:Class="ChatHelper.UI.SuggestionBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded">
    <Border x:Name="MainBorder" 
            CornerRadius="0" 
            Background="#FFFFE1" 
            BorderBrush="#000000" 
            BorderThickness="1" 
            Padding="6,3">
        <Border.Effect>
            <!-- 윈도우 98 클래식 하드 그림자 (블러 0, 정밀한 2px 오프셋) -->
            <DropShadowEffect BlurRadius="0" Direction="315" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel Orientation="Vertical">
            <StackPanel x:Name="ItemsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 시트 추천 칩 아이템들이 동적으로 여기에 추가됨 -->
            </StackPanel>
            <StackPanel x:Name="AiRowPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0" Visibility="Collapsed">
                <!-- 🤖 AI 추천 전용 별도 라인 -->
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
