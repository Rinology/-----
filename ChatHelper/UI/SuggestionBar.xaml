<Window x:Class="ChatHelper.UI.SuggestionBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemePillBg}"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded">
    <Border x:Name="MainBorder"
            Margin="0"
            CornerRadius="0"
            Background="{DynamicResource ThemePillBg}"
            BorderBrush="{DynamicResource ThemePillBorder}"
            BorderThickness="1"
            Padding="10,7">
        <StackPanel Orientation="Vertical">
            <Border x:Name="RecognitionHeaderBorder" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtRecognitionHeader" Grid.Column="0" Text="인식됨: " FontSize="11" FontWeight="SemiBold" Foreground="#334155" FontFamily="pack://application:,,,/DapJeongNer;component/Assets/Fonts/#Paperlogy" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtAutoHideCountdown" Grid.Column="1" Text="12s" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" FontFamily="pack://application:,,,/DapJeongNer;component/Assets/Fonts/#Paperlogy" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="BtnQuickRegisterToken" Grid.Column="2" Content="+ 메모" Visibility="Collapsed"
                            Style="{DynamicResource ThemeButtonStyle}"
                            FontSize="10.5" FontWeight="Bold" Padding="7,2" Margin="0,0,4,0" Cursor="Hand" Focusable="False"
                            Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1"
                            Foreground="{DynamicResource ThemeAccentText}"
                            ToolTip="현재 인식된 키워드/답변을 상담 메모 HUD에 달아둡니다 (\+M)"
                            Click="BtnQuickRegisterToken_Click"/>
                    <Button x:Name="BtnCloseSuggestion" Grid.Column="3" Content="✕"
                            Width="20" Height="20" Padding="0" Cursor="Hand" Focusable="False"
                            FontSize="11" FontWeight="Bold"
                            Background="Transparent" Foreground="#475569" BorderThickness="0"
                            ToolTip="추천/번역 창 즉시 닫기"
                            Click="BtnCloseSuggestion_Click"/>
                </Grid>
            </Border>
            <StackPanel x:Name="TopAiRowPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"/>
            <WrapPanel x:Name="ItemsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            <StackPanel x:Name="BottomAiRowPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtPositionNotice" Text="" Visibility="Collapsed"
                       FontSize="10.5" Foreground="#B45309" FontWeight="SemiBold"
                       FontFamily="pack://application:,,,/DapJeongNer;component/Assets/Fonts/#Paperlogy" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
