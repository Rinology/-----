<Window x:Class="ChatHelper.UI.SuggestionBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded">
    <Border x:Name="MainBorder" 
            CornerRadius="8" 
            Background="#1E1E24" 
            BorderBrush="#3B82F6" 
            BorderThickness="1" 
            Padding="6,3" 
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel x:Name="ItemsPanel" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 칩 아이템들이 동적으로 여기에 추가됨 -->
        </StackPanel>
    </Border>
</Window>
