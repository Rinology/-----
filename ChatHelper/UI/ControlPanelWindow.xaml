<Window x:Class="ChatHelper.UI.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper 제어판" 
        Height="720" Width="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <Border CornerRadius="{DynamicResource ThemeWindowCornerRadius}" 
            BorderThickness="{DynamicResource ThemeWindowBorderThickness}" 
            BorderBrush="{DynamicResource ThemeBorder}"
            Background="{DynamicResource ThemeBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- 1. 타이틀 바 -->
            <Grid Background="{DynamicResource ThemeTitleBg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="💻 ChatHelper 종합 제어판 &amp; 환경 설정" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
                <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" Margin="0,0,6,0" Click="BtnClose_Click"/>
            </Grid>

            <!-- 2. 탭 컨트롤 (넓고 쾌적한 레이아웃) -->
            <TabControl Grid.Row="1" Margin="14,10,14,6" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" FontSize="13">
                
                <!-- 탭 1: 커맨드(템플릿) 입력 및 관리 -->
                <TabItem Header="📋 커맨드 관리" Padding="16,8">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 데이터 그리드 -->
                        <DataGrid x:Name="DgTemplates" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  SelectionMode="Single"
                                  Background="{DynamicResource ThemeSurfaceBg}"
                                  BorderBrush="{DynamicResource ThemeBorder}"
                                  RowHeight="30"
                                  FontSize="13"
                                  SelectionChanged="DgTemplates_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="단축어(키워드)" Binding="{Binding Keyword}" Width="130"/>
                                <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="220"/>
                                <DataGridTextColumn Header="카테고리" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="내용 미리보기" Binding="{Binding Content}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 입력/수정 폼 -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" 
                                Background="{DynamicResource ThemeSurfaceBg}" CornerRadius="6" Padding="14" Margin="0,10,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="단축어:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtKw" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34"/>

                                <TextBlock Text="제목:" Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold" Margin="16,0,8,0"/>
                                <TextBox x:Name="TxtTitle" Grid.Column="3" Style="{DynamicResource ThemeTextBoxStyle}" Height="34"/>

                                <TextBlock Text="카테고리:" Grid.Column="4" VerticalAlignment="Center" FontWeight="Bold" Margin="16,0,8,0"/>
                                <TextBox x:Name="TxtCat" Grid.Column="5" Style="{DynamicResource ThemeTextBoxStyle}" Height="34"/>

                                <TextBlock Text="본문 내용:" Grid.Row="1" VerticalAlignment="Top" FontWeight="Bold" Margin="0,12,8,0"/>
                                <TextBox x:Name="TxtContent" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" 
                                         Style="{DynamicResource ThemeTextBoxStyle}" Height="65" TextWrapping="Wrap" 
                                         AcceptsReturn="True" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <!-- 액션 버튼 (잘림 방지) -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="➕ 신규 추가" Style="{DynamicResource ThemeButtonStyle}" MinWidth="115" Height="36" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                            <Button Content="✏️ 수정 적용" Style="{DynamicResource ThemeButtonStyle}" MinWidth="115" Height="36" Margin="0,0,8,0" Click="BtnUpdate_Click"/>
                            <Button Content="🗑️ 선택 삭제" Style="{DynamicResource ThemeButtonStyle}" MinWidth="115" Height="36" Margin="0,0,8,0" Click="BtnDelete_Click"/>
                            <Button Content="🧹 입력란 비우기" Style="{DynamicResource ThemeButtonStyle}" MinWidth="125" Height="36" Click="BtnClearForm_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 탭 2: 단축키 & 충돌 경고 -->
                <TabItem Header="⌨️ 단축키 설정" Padding="16,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- 카드 1: 수동 팝업 단축키 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="1. 수동 검색 팝업 단축키 (Alt+Q)" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="전역 호출 단축키:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtGlobalHotkey" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" FontSize="14" TextChanged="TxtGlobalHotkey_TextChanged"/>
                                        <TextBlock x:Name="LblHotkeyWarning" Grid.Column="2" Text="" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                    <TextBlock Text="• 언제 어디서든 이 키를 누르면 CS 템플릿 검색창이 즉시 열리며 키보드 방향키와 Enter로 바로 입력됩니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- 카드 2: 자동완성 완성 키 모드 (겹침 버그 완전 해결) -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="2. 자동완성 추천 알약 완성 방식" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="트리거 접두 키:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtTriggerKey" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" FontSize="14" Text="\"/>
                                        <TextBlock Grid.Column="2" Text="(한국어 키보드 원화 기호 ₩ 포함)" Foreground="{DynamicResource ThemeSubText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="완성 트리거 키 조합 선택:" FontWeight="SemiBold" Margin="0,6,0,8"/>
                                    
                                    <RadioButton x:Name="RadioSlashTab" Margin="8,6" IsChecked="True" Checked="CompleteKeyMode_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="[ ₩ / \ ] + [ Tab ]" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="추천 알약이 떴을 때 \와 Tab을 누르면 완성 (일반 Tab 기능 방해 없는 권장 모드)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RadioSlashOnly" Margin="8,6" Checked="CompleteKeyMode_Changed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                    <TextBlock Text="[ ₩ / \ ] 단독 즉시 실행" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="\ 키를 누르자마자 1번 추천 답변으로 즉시 치환 완성" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtSlashOnlyNotice" Text="※ '\' 단독 즉시 실행 모드에서는 1번 항목이 즉시 치환되므로 추천 알약 형태가 [단일 알약 툴팁]으로 자동 고정됩니다." Foreground="#B45309" FontWeight="SemiBold" FontSize="12" Margin="30,4,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RadioShiftSpace" Margin="8,6" Checked="CompleteKeyMode_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="[ Shift + Space ]" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="Shift와 스페이스바를 함께 누르면 완성" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <CheckBox x:Name="ChkNumbers" Content="트리거 활성 상태에서 1~9 숫자 키로 즉시 번호 선택 허용" Margin="8,12,0,0" IsChecked="True" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 3: 디자인 & 표시 (3대 OS 테마, 알약 크기, 위치 오프셋, 투명도) -->
                <TabItem Header="🎨 디자인 &amp; 표시" Padding="16,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- 윈도우 98 ME 클래식 단독 테마 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="1. 윈도우 비주얼 스타일" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                                    <Border Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Padding="14,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🖥️" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Windows 98 Millennium Edition (단독 테마)" FontWeight="Bold" FontSize="14" Foreground="#000080"/>
                                                <TextBlock Text="불필요한 테마 전환을 제거하고 안정적인 Windows 98 ME 클래식 UI (3D 베벨 &amp; 네이비 타이틀바)로 최적화되었습니다." Foreground="#4B5563" FontSize="12" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 알약 크기 3단계 조절 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="2. 추천 알약(Suggestion Pill) 크기 설정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RadioPillScale1" Content="1단계: 보통 크기 (1.0x 배율 - 미니멀한 크기)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioPillScale2" Content="2단계: 크게 (2.0x 배율 - 시원하고 가독성이 뛰어난 2배 크기, 권장)" Margin="8,5" IsChecked="True"/>
                                    <RadioButton x:Name="RadioPillScale3" Content="3단계: 아주 크게 (3.0x 배율 - 고해상도 모니터 및 대형 폰트)" Margin="8,5"/>
                                </StackPanel>
                            </Border>

                            <!-- 알약 위치 및 간격 설정 (채팅 방해 방지) -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="3. 알약 표시 위치 및 커서 간격 (채팅창 방해 방지)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="커서와 알약 사이의 거리를 조절하여 현재 입력 중인 채팅 글자가 가려지지 않게 합니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,10"/>

                                    <RadioButton x:Name="RadioPosNearby1" Content="옵션 1: 커서 바로 아래 밀착 (+15px)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioPosNearby2" Content="옵션 2: 커서 아래 넉넉한 간격 (+35px, 기본 권장)" Margin="8,5" IsChecked="True"/>
                                    <RadioButton x:Name="RadioPosFar" Content="옵션 3: 채팅창 시야 확보용 원거리 (+65px)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioPosFixed" Content="옵션 4: 화면 우측 하단 고정 알림 형태" Margin="8,5"/>
                                </StackPanel>
                            </Border>

                            <!-- 창 투명도 (흐리게) 조절 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="4. 알약 및 검색창 투명도 (흐리게 조절)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="배경 화면이 은은하게 비치도록 투명도를 조절할 수 있습니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,10"/>

                                    <RadioButton x:Name="RadioOpacity100" Content="100% 불투명 (완전 선명하게, 또렷함)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioOpacity90" Content="90% 약한 투명도 (자연스럽게 은은함, 기본 권장)" Margin="8,5" IsChecked="True"/>
                                    <RadioButton x:Name="RadioOpacity80" Content="80% 반투명 (뒤편 채팅창이 자연스럽게 비침)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioOpacity70" Content="70% 높은 투명도 (배경 텍스트가 훤히 보이는 흐린 모드)" Margin="8,5"/>
                                </StackPanel>
                            </Border>

                            <!-- 활성 상태 프로그램창 투명도 (바탕화면 비침 조절) -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="5. 활성 상태 프로그램창 투명도 (바탕화면 비침 조절)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="화면 우측 하단 프로그램창이 바탕화면 위에서 은은하게 비치도록 투명도를 조절합니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,10"/>

                                    <RadioButton x:Name="RadioStatusOpacity100" Content="100% 불투명 (선명하게)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioStatusOpacity85" Content="85% 은은한 투명도 (바탕화면이 자연스럽게 비침, 기본 권장)" Margin="8,5" IsChecked="True"/>
                                    <RadioButton x:Name="RadioStatusOpacity65" Content="65% 반투명 (배경이 훤히 비침)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioStatusOpacity45" Content="45% 높은 투명도 (유리처럼 투명)" Margin="8,5"/>
                                </StackPanel>
                            </Border>

                            <!-- 추천 바 형태 및 상태창 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="6. 추천 바 형태 및 작업표시줄 설정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RadioModeInline" Content="인라인 스마트 알약 툴팁 (1개 칩 형태)" Margin="8,4" IsChecked="True"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="8,4">
                                        <RadioButton x:Name="RadioModeHorizontal" Content="가로형 멀티 추천 바 — 표시 개수: " VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbMaxCandidates" Width="75" Height="28" Margin="6,0,8,0" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="3개"/>
                                            <ComboBoxItem Content="4개"/>
                                            <ComboBoxItem Content="5개" IsSelected="True"/>
                                            <ComboBoxItem Content="6개"/>
                                            <ComboBoxItem Content="7개"/>
                                            <ComboBoxItem Content="8개"/>
                                            <ComboBoxItem Content="9개"/>
                                            <ComboBoxItem Content="10개"/>
                                        </ComboBox>
                                        <TextBlock Text="(3 ~ 최대 10개 선택 가능)" Foreground="{DynamicResource ThemeSubText}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <RadioButton x:Name="RadioModeManual" Content="수동 검색 모드만 사용 (Alt+Q 전용)" Margin="8,4"/>

                                    <CheckBox x:Name="ChkShowStatusWindow" Content="화면 우측 하단 및 작업표시줄에 실행 상태표시창 항상 보이기" Margin="8,12,0,2" IsChecked="True" FontWeight="SemiBold"/>
                                    <TextBlock Text="  (체크 해제 시 작업표시줄에서 숨겨지고 우측 하단 트레이 아이콘으로만 작동합니다.)" Foreground="{DynamicResource ThemeSubText}" FontSize="11" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 4: 시트 연동 및 업로드 -->
                <TabItem Header="☁️ 시트 연동 &amp; 라이선스" Padding="16,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- 사용자 라이선스 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="현재 로그온 사용자 계정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="LblCurrentUserInfo" Text="로그인 정보 로드 중..." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,10"/>
                                    <Button Content="👤 다른 사용자로 다시 로그온..." Style="{DynamicResource ThemeButtonStyle}" MinWidth="200" Height="34" HorizontalAlignment="Left" Click="BtnRelogin_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 구글 스프레드시트 배포 URL -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="구글 스프레드시트 양방향 연동 설정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                    <TextBlock Text="1. 템플릿 다운로드 CSV 웹게시 링크:" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,3"/>
                                    <TextBox x:Name="TxtTemplateUrl" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" Margin="0,0,0,10"/>

                                    <TextBlock Text="2. 유저 라이선스 CSV 웹게시 링크:" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,3"/>
                                    <TextBox x:Name="TxtUserUrl" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" Margin="0,0,0,10"/>

                                    <TextBlock Text="3. 스프레드시트 신규 템플릿/자연어 업로드 웹앱 URL (Google Apps Script):" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,3"/>
                                    <TextBox x:Name="TxtUploadUrl" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" Margin="0,0,0,14"/>

                                    <Button Content="🔄 구글 시트에서 전체 최신 동기화 실행" Style="{DynamicResource ThemeButtonStyle}" MinWidth="260" Height="36" HorizontalAlignment="Left" Click="BtnSyncAll_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 5: 버전 정보 & 로컬 AI -->
                <TabItem Header="ℹ️ 버전 &amp; 로컬 AI" Padding="16,8">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="64" Height="64" Background="{DynamicResource ThemeAccent}" CornerRadius="10" VerticalAlignment="Top">
                            <TextBlock Text="ME" Foreground="White" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="ChatHelper Millennium Edition" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            <TextBlock Text="Version 2.2.0 (Build 2026.11.18)" FontSize="12" Foreground="{DynamicResource ThemeSubText}" Margin="0,3,0,14"/>

                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="🤖 초경량 로컬 AI 시맨틱 검색 엔진 (계획)" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                    <TextBlock Text="• 수백 개의 키워드를 외우지 않아도, 사용자가 '돈 환불해달래' 처럼 자연어로 검색하면 AI가 의미를 파악해 최적의 답변 템플릿을 추천합니다." FontSize="12" Foreground="{DynamicResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="• 기반 기술: Microsoft ONNX Runtime + BGE-m3 / KR-SBERT INT8 (약 35MB 단일 파일, CPU 0.01초 추론, 인터넷 불필요)" FontSize="12" Foreground="{DynamicResource ThemeSubText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 3. 하단 상태 바 및 저장 버튼 (잘림 방지) -->
            <Grid Grid.Row="2" Margin="16,0,16,0">
                <TextBlock x:Name="LblStatusBar" VerticalAlignment="Center" Text="준비 완료" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="💾 설정 저장 및 적용" Style="{DynamicResource ThemeButtonStyle}" MinWidth="165" Height="34" Margin="0,0,8,0" Click="BtnSaveAndClose_Click"/>
                    <Button Content="닫기" Style="{DynamicResource ThemeButtonStyle}" MinWidth="85" Height="34" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
