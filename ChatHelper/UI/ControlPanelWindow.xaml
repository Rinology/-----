<Window x:Class="ChatHelper.UI.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper 제어판" 
        Height="760" Width="1160"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource ThemeBg}"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <Border Margin="0" CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
            Background="{DynamicResource ThemeBg}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 1. 타이틀 바 -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,10,0">
                    <TextBlock Text="ChatHelper 환경 설정" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="13.5" FontFamily="Malgun Gothic, Segoe UI" VerticalAlignment="Center"/>
                    <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 2. 탭 컨트롤 (넓고 쾌적한 레이아웃) -->
            <TabControl Grid.Row="1" Margin="14,10,14,6" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" FontSize="13">
                
                <!-- 탭 1: 커맨드 & 업무 시트 통합 관리 -->
                <TabItem Header="📋 커맨드 &amp; 시트 관리" Padding="16,8">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 1행: 업무 프로필 선택 & 개인 시트 토글 바 -->
                        <Border Grid.Row="0" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="업무 프로필:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbActivePreset" Grid.Column="1" Width="200" Height="30" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnPresetSwitch" Grid.Column="2" Content="✅ 적용 및 동기화" Style="{DynamicResource ThemeButtonStyle}" Height="30" Padding="12,0" Margin="8,0,0,0" Click="BtnPresetSwitch_Click"/>
                                    <Button x:Name="BtnPresetRefresh" Grid.Column="3" Content="🔄 목록 새로고침" Style="{DynamicResource ThemeButtonStyle}" Height="30" Padding="10,0" Margin="6,0,0,0" Click="BtnPresetRefresh_Click"/>
                                    <TextBlock x:Name="LblActiveProfile" Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="BtnToggleUserSheetManager" Grid.Column="5" Content="⚙ 개인 시트 추가/삭제 ▾" Style="{DynamicResource ThemeButtonStyle}" Height="30" Padding="12,0" Click="BtnToggleUserSheetManager_Click"/>
                                </Grid>
                                <ProgressBar x:Name="PbarProfileSync" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,2"/>
                                <TextBlock x:Name="TxtProfileSyncStatus" Text="" FontSize="11.5" Foreground="{DynamicResource ThemeSubText}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- 2행: 접이식 개인 시트 추가/삭제 패널 (서버 저장 vs 로컬 PC 저장) -->
                        <Border x:Name="PanelUserSheetManager" Grid.Row="1" Visibility="Collapsed"
                                Background="{DynamicResource ThemePanelBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <TabControl Background="Transparent" BorderThickness="0">
                                <!-- 서브 탭 1: 서버 저장 (GAS 클라우드 · 계정 로밍) -->
                                <TabItem Header="☁️ 서버 시트 (계정 로밍)" Padding="12,5">
                                    <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                                        <StackPanel>
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                                        <TextBlock Text="1) 공유 안내: 구글 시트 우측 상단 [공유]에서 " FontSize="11.5" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                        <TextBox Text="taerin@qualisports.kr" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="Bold" FontSize="11.5" Foreground="#1D4ED8" VerticalAlignment="Center" Padding="2,0"/>
                                                        <TextBlock Text=" 을(를) 편집자로 추가하세요." FontSize="11.5" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                        <Button Content="복사" Padding="6,1" Margin="6,0,0,0" FontSize="10.5" Cursor="Hand" Click="BtnCopyGasEmail_Click"/>
                                                    </StackPanel>
                                                    <TextBlock Text="2) 필수 1행 헤더 컬럼:  keyword  |  contentKeyword  |  title  |  content  |  category" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                                </StackPanel>
                                            </Border>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="115"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtGasProfileName" Grid.Column="0" Height="28" Padding="6,4" ToolTip="시트 이름 (예: 내 팀 시트)"/>
                                                <TextBox x:Name="TxtGasProfileUrl" Grid.Column="2" Height="28" Padding="6,4" ToolTip="구글 시트 편집 URL"/>
                                                <TextBox x:Name="TxtGasProfileTab" Grid.Column="4" Height="28" Padding="6,4" Text="채팅템플릿" ToolTip="시트 하단 탭 이름"/>
                                                <Button x:Name="BtnAddGasProfile" Grid.Column="6" Content="☁️ 추가" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="12,0" Click="BtnAddGasProfile_Click"/>
                                                <Button x:Name="BtnDeleteGasProfile" Grid.Column="8" Content="🗑 삭제" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="10,0" Click="BtnDeleteGasProfile_Click"/>
                                            </Grid>

                                            <ProgressBar x:Name="PbarGasProfile" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtGasProfileStatus" Text="" FontSize="11.5" Visibility="Collapsed" Margin="0,0,0,4"/>
                                            <ListBox x:Name="LstGasUserProfiles" Height="72" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" FontSize="11.5"/>
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <!-- 서브 탭 2: 로컬 PC 저장 (구글 시트 없이 이 PC에서만 바로 입력/사용) -->
                                <TabItem Header="💻 로컬 PC 시트 (이 PC 전용)" Padding="12,5">
                                    <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="구글 시트 연결 없이 이 PC에서만 쓰는 나만의 문구 목록입니다. 목록 이름만 추가한 뒤 우측 커맨드 편집기에서 단축어와 답변을 바로 입력하세요." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtLocalProfileName" Grid.Column="0" Height="28" Padding="8,4" ToolTip="목록 이름 (예: 내 개인 문구)"/>
                                                <Button x:Name="BtnAddLocalProfile" Grid.Column="2" Content="💻 내 PC 목록 추가 및 사용" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="12,0" Click="BtnAddLocalProfile_Click"/>
                                                <Button x:Name="BtnDeleteLocalProfile" Grid.Column="4" Content="🗑 선택 삭제" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="10,0" Click="BtnDeleteLocalProfile_Click"/>
                                            </Grid>

                                            <TextBlock x:Name="TxtLocalProfileStatus" Text="" FontSize="11.5" Visibility="Collapsed" Margin="0,0,0,4"/>
                                            <ListBox x:Name="LstLocalUserProfiles" Height="72" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" FontSize="11.5"/>
                                        </StackPanel>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </Border>

                        <!-- 3행: 좌측(목록) ↔ 우측(긴 본문 상세 편집기) 2단 분할 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" MinWidth="420"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="0.85*" MinWidth="360"/>
                            </Grid.ColumnDefinitions>

                            <!-- 좌측: 검색 필터 + DataGrid -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="검색 필터:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtCmdFilter" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="30"
                                             ToolTip="단축어, 제목, 본문 내용으로 바로 검색합니다"
                                             TextChanged="TxtCmdFilter_TextChanged"/>
                                </Grid>

                                <DataGrid x:Name="DgTemplates" Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          Background="{DynamicResource ThemeSurfaceBg}"
                                          BorderBrush="{DynamicResource ThemeBorder}"
                                          RowHeight="30"
                                          FontSize="12.5"
                                          SelectionChanged="DgTemplates_SelectionChanged"
                                          MouseDoubleClick="DgTemplates_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="단축어" Binding="{Binding Keyword}" Width="105"/>
                                        <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="170"/>
                                        <DataGridTextColumn Header="카테고리" Binding="{Binding Category}" Width="90"/>
                                        <DataGridTextColumn Header="내용 미리보기" Binding="{Binding Content}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                            <!-- 우측: 긴 본문 전용 상세 보기/편집기 (남은 세로 공간 전체 + 자동 스크롤) -->
                            <Border Grid.Column="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                    Background="{DynamicResource ThemeSurfaceBg}" CornerRadius="6" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="선택 항목 상세 보기 / 편집" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,10"/>

                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="단축어 (키워드)" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtKw" Style="{DynamicResource ThemeTextBoxStyle}" Height="32"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="카테고리" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtCat" Style="{DynamicResource ThemeTextBoxStyle}" Height="32"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                        <TextBlock Text="제목" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtTitle" Style="{DynamicResource ThemeTextBoxStyle}" Height="32"/>
                                    </StackPanel>

                                    <Grid Grid.Row="3" Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="본문 내용 (길면 자동 스크롤 생성)" FontSize="11.5" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtContentLength" Text="0자" FontSize="11" Foreground="{DynamicResource ThemeSubText}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBox x:Name="TxtContent" Grid.Row="1"
                                                 Style="{DynamicResource ThemeTextBoxStyle}"
                                                 VerticalContentAlignment="Top"
                                                 Padding="8"
                                                 FontSize="13"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="TxtContent_TextChanged"/>
                                    </Grid>

                                    <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
                                        <Button Content="➕ 신규 추가" Style="{DynamicResource ThemeButtonStyle}" MinWidth="95" Height="34" Margin="0,0,6,4" Click="BtnAdd_Click"/>
                                        <Button Content="✏️ 수정 적용" Style="{DynamicResource ThemeButtonStyle}" MinWidth="95" Height="34" Margin="0,0,6,4" Click="BtnUpdate_Click"/>
                                        <Button Content="🗑️ 선택 삭제" Style="{DynamicResource ThemeButtonStyle}" MinWidth="95" Height="34" Margin="0,0,6,4" Click="BtnDelete_Click"/>
                                        <Button Content="🧹 비우기" Style="{DynamicResource ThemeButtonStyle}" MinWidth="78" Height="34" Margin="0,0,0,4" Click="BtnClearForm_Click"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 탭 2: 단축키 & 충돌 경고 -->
                <TabItem Header="⌨️ 단축키 설정" Padding="16,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- 카드 1: 수동 팝업 단축키 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="1. 수동 검색 팝업 단축키 (Alt+Q)" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="전역 호출 단축키:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtGlobalHotkey" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" FontSize="14" TextChanged="TxtGlobalHotkey_TextChanged"/>
                                        <TextBlock x:Name="LblHotkeyWarning" Grid.Column="2" Text="" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                    <TextBlock Text="• 언제 어디서든 이 키를 누르면 템플릿 검색창이 즉시 열리며 키보드 방향키와 Enter로 바로 입력됩니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- 카드 2: 자동완성 완성 키 모드 (겹침 버그 완전 해결) -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="2. 자동완성 추천 알약 완성 방식" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="트리거 접두 키:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtTriggerKey" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" FontSize="14" Text="\"/>
                                        <TextBlock Grid.Column="2" Text="(한국어 키보드 원화 기호 ₩ 포함)" Foreground="{DynamicResource ThemeSubText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="완성 트리거 키 조합 선택:" FontWeight="SemiBold" Margin="0,6,0,8"/>
                                    
                                    <RadioButton x:Name="RadioSlashTab" Margin="8,6" IsChecked="True" Checked="CompleteKeyMode_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="[ ₩ / \ ] + [ Tab ]" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="추천 알약이 떴을 때 \와 Tab을 누르면 완성 (일반 Tab 기능 방해 없는 권장 모드)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RadioSlashOnly" Margin="8,6" Checked="CompleteKeyMode_Changed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                    <TextBlock Text="[ ₩ / \ ] 단독 즉시 실행" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="\ 키를 누르자마자 1번 추천 답변으로 즉시 치환 완성" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtSlashOnlyNotice" Text="※ '\' 단독 즉시 실행 모드에서는 1번 항목이 즉시 치환되므로 추천 알약 형태가 [단일 알약 툴팁]으로 자동 고정됩니다." Foreground="#B45309" FontWeight="SemiBold" FontSize="12" Margin="30,4,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RadioShiftSpace" Margin="8,6" Checked="CompleteKeyMode_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="[ Shift + Space ]" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="Shift와 스페이스바를 함께 누르면 완성" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <CheckBox x:Name="ChkNumbers" Content="트리거 활성 상태에서 1~9 숫자 키로 즉시 번호 선택 허용" Margin="8,12,0,0" IsChecked="True" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 3: 디자인 & 표시 -->
                <TabItem Header="디자인 &amp; 표시" Padding="16,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- UI 테마 포인트 컬러 선택 (Windows 11 Fluent 라이트 화이트 베이스) -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="0. UI 포인트 컬러 (Windows 11 Fluent 라이트)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="깔끔한 화이트 베이스 위에 원하는 파스텔/포인트 컬러를 선택하면 즉시 미리보기로 반영됩니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,10"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RadioAccentBlue" GroupName="UiAccentGroup" Content="🔵 화이트 &amp; 블루 (기본)" Margin="8,5,16,5" IsChecked="True" Checked="RadioAccent_Checked"/>
                                        <RadioButton x:Name="RadioAccentGreen" GroupName="UiAccentGroup" Content="🟢 화이트 &amp; 민트 그린" Margin="8,5,16,5" Checked="RadioAccent_Checked"/>
                                        <RadioButton x:Name="RadioAccentLavender" GroupName="UiAccentGroup" Content="🟣 화이트 &amp; 라벤더" Margin="8,5,16,5" Checked="RadioAccent_Checked"/>
                                        <RadioButton x:Name="RadioAccentPeach" GroupName="UiAccentGroup" Content="🟠 화이트 &amp; 코랄 피치" Margin="8,5,16,5" Checked="RadioAccent_Checked"/>
                                        <RadioButton x:Name="RadioAccentPink" GroupName="UiAccentGroup" Content="🩷 화이트 &amp; 로즈 핑크" Margin="8,5,16,5" Checked="RadioAccent_Checked"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 알약 크기 3단계 조절 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="1. 추천 알약(Suggestion Pill) 크기 설정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RadioPillScale1" Content="1단계: 보통 크기 (1.0x 배율 - 미니멀한 크기)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioPillScale2" Content="2단계: 크게 (2.0x 배율 - 시원하고 가독성이 뛰어난 2배 크기, 권장)" Margin="8,5" IsChecked="True"/>
                                    <RadioButton x:Name="RadioPillScale3" Content="3단계: 아주 크게 (3.0x 배율 - 고해상도 모니터 및 대형 폰트)" Margin="8,5"/>
                                </StackPanel>
                            </Border>

                            <!-- 알약 위치 및 간격 설정 (채팅 방해 방지) -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="3. 알약 표시 위치 및 커서 간격 (채팅창 방해 방지)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="커서와 알약 사이의 거리를 조절하여 현재 입력 중인 채팅 글자가 가려지지 않게 합니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,10"/>

                                    <RadioButton x:Name="RadioPosNearby1" Content="옵션 1: 커서 바로 아래 밀착 (+15px)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioPosNearby2" Content="옵션 2: 커서 아래 넉넉한 간격 (+35px, 기본 권장)" Margin="8,5" IsChecked="True"/>
                                    <RadioButton x:Name="RadioPosFar" Content="옵션 3: 채팅창 시야 확보용 원거리 (+65px)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioPosMouse" Content="옵션 4: 마우스 포인터 위치 기준 (마우스 커서 근처에 표시)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioPosFixed" Content="옵션 5: 화면 우측 하단 고정 알림 형태" Margin="8,5"/>
                                </StackPanel>
                            </Border>

                            <!-- 창 투명도 (흐리게) 조절 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="4. 알약 및 검색창 투명도 (흐리게 조절)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="배경 화면이 은은하게 비치도록 투명도를 조절할 수 있습니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,10"/>

                                    <RadioButton x:Name="RadioOpacity100" Content="100% 불투명 (완전 선명하게, 또렷함)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioOpacity90" Content="90% 약한 투명도 (자연스럽게 은은함, 기본 권장)" Margin="8,5" IsChecked="True"/>
                                    <RadioButton x:Name="RadioOpacity80" Content="80% 반투명 (뒤편 채팅창이 자연스럽게 비침)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioOpacity70" Content="70% 높은 투명도 (배경 텍스트가 훤히 보이는 흐린 모드)" Margin="8,5"/>
                                </StackPanel>
                            </Border>

                            <!-- 활성 상태 프로그램창 투명도 (바탕화면 비침 조절) -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="5. 활성 상태 프로그램창 투명도 (바탕화면 비침 조절)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="화면 우측 하단 프로그램창이 바탕화면 위에서 은은하게 비치도록 투명도를 조절합니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,10"/>

                                    <RadioButton x:Name="RadioStatusOpacity100" Content="100% 불투명 (선명하게)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioStatusOpacity85" Content="85% 은은한 투명도 (바탕화면이 자연스럽게 비침, 기본 권장)" Margin="8,5" IsChecked="True"/>
                                    <RadioButton x:Name="RadioStatusOpacity65" Content="65% 반투명 (배경이 훤히 비침)" Margin="8,5"/>
                                    <RadioButton x:Name="RadioStatusOpacity45" Content="45% 높은 투명도 (유리처럼 투명)" Margin="8,5"/>
                                </StackPanel>
                            </Border>

                            <!-- 추천 바 형태 및 상태창 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="6. 추천 바 형태 및 작업표시줄 설정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RadioModeInline" GroupName="DisplayModeGroup" Content="인라인 스마트 알약 툴팁 (1개 칩 형태)" Margin="8,4" IsChecked="True"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="8,4">
                                        <RadioButton x:Name="RadioModeHorizontal" GroupName="DisplayModeGroup" Content="가로형 멀티 추천 바 — 표시 개수: " VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbMaxCandidates" Width="75" Height="28" Margin="6,0,8,0" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="3개"/>
                                            <ComboBoxItem Content="4개"/>
                                            <ComboBoxItem Content="5개" IsSelected="True"/>
                                            <ComboBoxItem Content="6개"/>
                                            <ComboBoxItem Content="7개"/>
                                            <ComboBoxItem Content="8개"/>
                                            <ComboBoxItem Content="9개"/>
                                            <ComboBoxItem Content="10개"/>
                                        </ComboBox>
                                        <TextBlock Text="(3 ~ 최대 10개 선택 가능)" Foreground="{DynamicResource ThemeSubText}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <RadioButton x:Name="RadioModeManual" GroupName="DisplayModeGroup" Content="수동 검색 모드만 사용 (Alt+Q 전용)" Margin="8,4"/>

                                    <CheckBox x:Name="ChkShowStatusWindow" Content="화면 우측 하단 및 작업표시줄에 실행 상태표시창 항상 보이기" Margin="8,12,0,2" IsChecked="True" FontWeight="SemiBold"/>
                                    <TextBlock Text="  (체크 해제 시 작업표시줄에서 숨겨지고 우측 하단 트레이 아이콘으로만 작동합니다.)" Foreground="{DynamicResource ThemeSubText}" FontSize="11" Margin="8,0,0,0"/>

                                    <StackPanel Orientation="Horizontal" Margin="8,10,0,0">
                                        <TextBlock Text="추천 알약 자동 숨김 시간:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="CmbAutoHideSeconds" Width="130" Height="28" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="5초" Tag="5"/>
                                            <ComboBoxItem Content="8초" Tag="8"/>
                                            <ComboBoxItem Content="12초 (기본)" Tag="12" IsSelected="True"/>
                                            <ComboBoxItem Content="15초" Tag="15"/>
                                            <ComboBoxItem Content="20초 (최대)" Tag="20"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <CheckBox x:Name="ChkEnableMathCalc" Content="🧮 사칙연산 자동 계산 기능 사용 (예: 5 * 10 = 입력 시 50 즉시 추천)" Margin="8,12,0,2" IsChecked="True" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="ChkEnableTranslation" Content="구글 번역기형 실시간 번역 패널 사용 (문장 입력 시 원문 ↔ 영문 나란히 표시)" Margin="8,8,0,2" IsChecked="False" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 4: 데이터 동기화 & 계정 -->
                <TabItem Header="🔄 동기화 &amp; 계정" Padding="16,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- 구글 스프레드시트 주기적 자동 동기화 설정 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="1. 구글 스프레드시트 최신 정보 자동 동기화 주기" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="관리자가 구글 스프레드시트에서 수정한 단축키, 답변 문구, 용어집을 백그라운드에서 자동으로 다운로드하여 항상 최신 상태로 유지합니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="자동 갱신 주기:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                        <ComboBox x:Name="CmbAutoSyncInterval" Width="200" Height="32" VerticalContentAlignment="Center" FontSize="13">
                                            <ComboBoxItem Content="5분마다 자동 갱신" Tag="5"/>
                                            <ComboBoxItem Content="10분마다 자동 갱신" Tag="10"/>
                                            <ComboBoxItem Content="15분마다 자동 갱신 (권장)" Tag="15"/>
                                            <ComboBoxItem Content="30분마다 자동 갱신" Tag="30"/>
                                            <ComboBoxItem Content="60분(1시간)마다 갱신" Tag="60"/>
                                            <ComboBoxItem Content="자동 갱신 사용 안 함 (수동)" Tag="0"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="💡 무소음 &amp; Zero-Lag 보장" FontWeight="Bold" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 상담원이 고객과 대화 중일 때도 키보드 타이핑 렉이 전혀 발생하지 않도록 백그라운드 스레드에서 조용히 갱신됩니다." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
                                            <TextBlock Text="• 동기화 주기와 상관없이 아래 버튼을 누르면 언제든지 지금 즉시 최신 정보를 가져올 수 있습니다." FontSize="11" Foreground="#6B7280" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="🔄 지금 즉시 최신 정보 동기화 실행" Style="{DynamicResource ThemeButtonStyle}" MinWidth="230" Height="36" HorizontalAlignment="Left" Click="BtnSyncAll_Click"/>

                                    <!-- 바로등록 기능 임시 비활성화 -->
                                    <CheckBox x:Name="ChkQuickSaveWithoutDialog"
                                              Visibility="Collapsed"
                                              Content="시트 등록 시 상세 입력창을 묻지 않고 즉시 바로 저장 (단축어·클립보드 내용 바로 등록)"
                                              Margin="0,12,0,0" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <!-- 사용자 라이선스 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="2. 현재 로그온 사용자 계정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="LblCurrentUserInfo" Text="로그인 정보 로드 중..." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,10"/>
                                    <Button Content="👤 다른 사용자로 다시 로그온..." Style="{DynamicResource ThemeButtonStyle}" MinWidth="200" Height="34" HorizontalAlignment="Left" Click="BtnRelogin_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                </TabControl>

            <!-- 3. 하단 상태 바 및 저장 버튼 (잘림 방지) -->
            <Grid Grid.Row="2" Margin="16,0,16,0">
                <TextBlock x:Name="LblStatusBar" VerticalAlignment="Center" Text="준비 완료" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="설정 저장 및 적용" Style="{DynamicResource ThemeButtonStyle}" MinWidth="150" Height="34" Margin="0,0,8,0" Click="BtnSaveAndClose_Click"/>
                    <Button Content="닫기" Style="{DynamicResource ThemeButtonStyle}" MinWidth="80" Height="34" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
