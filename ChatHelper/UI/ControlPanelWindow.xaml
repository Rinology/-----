<Window x:Class="ChatHelper.UI.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper 제어판" 
        Height="680" Width="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource ThemeBg}"
        BorderBrush="{DynamicResource ThemeAccent}"
        BorderThickness="2"
        ResizeMode="NoResize">
    <Border BorderThickness="1" BorderBrush="{DynamicResource ThemeBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- 1. 타이틀 바 -->
            <Grid Background="{DynamicResource ThemeTitleBg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="💻 ChatHelper 제어판 &amp; 환경 설정" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
                <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" Margin="0,0,6,0" Click="BtnClose_Click"/>
            </Grid>

            <!-- 2. 탭 컨트롤 (넓고 쾌적한 레이아웃) -->
            <TabControl Grid.Row="1" Margin="12,10,12,6" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" FontSize="13">
                
                <!-- 탭 1: 커맨드(템플릿) 입력 및 관리 -->
                <TabItem Header="📋 커맨드 관리" Padding="14,6">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 데이터 그리드 -->
                        <DataGrid x:Name="DgTemplates" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  SelectionMode="Single"
                                  Background="{DynamicResource ThemeSurfaceBg}"
                                  BorderBrush="{DynamicResource ThemeBorder}"
                                  RowHeight="28"
                                  FontSize="13"
                                  SelectionChanged="DgTemplates_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="키워드(단축어)" Binding="{Binding Keyword}" Width="130"/>
                                <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="200"/>
                                <DataGridTextColumn Header="카테고리" Binding="{Binding Category}" Width="110"/>
                                <DataGridTextColumn Header="내용 미리보기" Binding="{Binding Content}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 입력/수정 폼 -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" 
                                Background="{DynamicResource ThemeSurfaceBg}" CornerRadius="6" Padding="12" Margin="0,10,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="단축어:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtKw" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="32"/>

                                <TextBlock Text="제목:" Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold" Margin="14,0,8,0"/>
                                <TextBox x:Name="TxtTitle" Grid.Column="3" Style="{DynamicResource ThemeTextBoxStyle}" Height="32"/>

                                <TextBlock Text="카테고리:" Grid.Column="4" VerticalAlignment="Center" FontWeight="Bold" Margin="14,0,8,0"/>
                                <TextBox x:Name="TxtCat" Grid.Column="5" Style="{DynamicResource ThemeTextBoxStyle}" Height="32"/>

                                <TextBlock Text="내용:" Grid.Row="1" VerticalAlignment="Top" FontWeight="Bold" Margin="0,10,8,0"/>
                                <TextBox x:Name="TxtContent" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" 
                                         Style="{DynamicResource ThemeTextBoxStyle}" Height="60" TextWrapping="Wrap" 
                                         AcceptsReturn="True" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <!-- 액션 버튼 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="➕ 신규 추가" Style="{DynamicResource ThemeButtonStyle}" Width="105" Height="34" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                            <Button Content="✏️ 수정 적용" Style="{DynamicResource ThemeButtonStyle}" Width="105" Height="34" Margin="0,0,8,0" Click="BtnUpdate_Click"/>
                            <Button Content="🗑️ 선택 삭제" Style="{DynamicResource ThemeButtonStyle}" Width="105" Height="34" Margin="0,0,8,0" Click="BtnDelete_Click"/>
                            <Button Content="🧹 입력란 비우기" Style="{DynamicResource ThemeButtonStyle}" Width="120" Height="34" Click="BtnClearForm_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 탭 2: 단축키 & 충돌 경고 (시원한 카드 UI) -->
                <TabItem Header="⌨️ 단축키 설정" Padding="14,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- 카드 1: 수동 팝업 단축키 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="1. 수동 검색 팝업 단축키 (Alt+Q)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="전역 호출 단축키:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtGlobalHotkey" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" FontSize="14" TextChanged="TxtGlobalHotkey_TextChanged"/>
                                        <TextBlock x:Name="LblHotkeyWarning" Grid.Column="2" Text="" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                    <TextBlock Text="• 언제 어디서든 이 키를 누르면 CS 템플릿 검색창이 즉시 열리며 키보드 방향키와 Enter로 바로 입력됩니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- 카드 2: 자동완성 완성 키 모드 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="2. 자동완성 추천 알약 완성 방식" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="트리거 접두 키:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtTriggerKey" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" FontSize="14" Text="\"/>
                                        <TextBlock Text="(한국어 키보드 원화 기호 ₩ 포함)" Foreground="{DynamicResource ThemeSubText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="완성 트리거 키 조합 선택:" FontWeight="SemiBold" Margin="0,6,0,6"/>
                                    <RadioButton x:Name="RadioSlashTab" Margin="8,4" IsChecked="True">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="[ ₩ / \ ] + [ Tab ]" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="추천 알약이 떴을 때 \와 Tab을 누르면 완성 (일반 Tab 사용 방해 없는 권장 방식)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RadioSlashOnly" Margin="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="[ ₩ / \ ] 단독 누름" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="\ 키를 누르자마자 1번 추천 답변으로 즉시 치환 완성" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RadioShiftSpace" Margin="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="[ Shift + Space ]" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="Shift와 스페이스바를 함께 누르면 완성" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <CheckBox x:Name="ChkNumbers" Content="트리거 활성 상태에서 1~9 숫자 키로 즉시 번호 선택 허용" Margin="8,10,0,0" IsChecked="True" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 3: 디자인 & 표시 (알약 3단계 크기 조절 & 테마) -->
                <TabItem Header="🎨 디자인 &amp; 표시" Padding="14,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- 테마 선택 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="UI 비주얼 스타일 테마 선택 (실시간 반영)" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RadioThemeWin98" Content="🖥️ Windows 98 Millennium Edition (클래식 3D 베벨 &amp; 레트로 실버)" Margin="8,4" IsChecked="True" Checked="ThemeRadio_Checked"/>
                                    <RadioButton x:Name="RadioThemeDark" Content="🌙 Modern Dark (세련되고 눈이 편안한 현대적 다크 모드)" Margin="8,4" Checked="ThemeRadio_Checked"/>
                                    <RadioButton x:Name="RadioThemeLight" Content="☀️ Modern Light (깔끔하고 시원한 모던 화이트/라이트 모드)" Margin="8,4" Checked="ThemeRadio_Checked"/>
                                </StackPanel>
                            </Border>

                            <!-- 알약 크기 3단계 조절 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="추천 알약(Suggestion Pill) 크기 설정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="상담 화면에서 타이핑 시 커서 옆에 나타나는 추천 알약의 크기를 조절합니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,8"/>

                                    <RadioButton x:Name="RadioPillScale1" Content="1단계: 보통 크기 (1.0x 배율 - 미니멀한 알약)" Margin="8,4"/>
                                    <RadioButton x:Name="RadioPillScale2" Content="2단계: 크게 (2.0x 배율 - 시원하고 가독성이 뛰어난 2배 크기, 권장)" Margin="8,4" IsChecked="True"/>
                                    <RadioButton x:Name="RadioPillScale3" Content="3단계: 아주 크게 (3.0x 배율 - 고해상도 모니터 및 대형 폰트)" Margin="8,4"/>
                                </StackPanel>
                            </Border>

                            <!-- 추천 바 형태 및 상태표시줄 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="추천 창 형태 및 작업표시줄 설정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RadioModeInline" Content="옵션 1: 스마트폰 인라인 알약 툴팁 (1개 칩)" Margin="8,3" IsChecked="True"/>
                                    <RadioButton x:Name="RadioModeHorizontal" Content="옵션 2: 가로형 미니 추천 바 (최대 3개 칩)" Margin="8,3"/>
                                    <RadioButton x:Name="RadioModeManual" Content="옵션 3: 수동 검색 모드만 사용 (Alt+Q 전용)" Margin="8,3"/>

                                    <CheckBox x:Name="ChkShowStatusWindow" Content="화면 우측 하단 및 작업표시줄에 실행 상태표시창 항상 보이기" Margin="8,10,0,2" IsChecked="True" FontWeight="SemiBold"/>
                                    <TextBlock Text="  (체크 해제 시 작업표시줄에서 숨겨지고 우측 하단 트레이 아이콘으로만 조용히 작동합니다.)" Foreground="{DynamicResource ThemeSubText}" FontSize="11" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 4: 시트 연동 및 업로드 -->
                <TabItem Header="☁️ 시트 연동 &amp; 라이선스" Padding="14,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- 사용자 라이선스 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="현재 로그온 사용자 계정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="LblCurrentUserInfo" Text="로그인 정보 로드 중..." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,10"/>
                                    <Button Content="👤 다른 사용자로 다시 로그온..." Style="{DynamicResource ThemeButtonStyle}" Width="200" Height="32" HorizontalAlignment="Left" Click="BtnRelogin_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 구글 스프레드시트 배포 URL -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="구글 스프레드시트 양방향 연동 설정" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                    <TextBlock Text="1. 템플릿 다운로드 CSV 웹게시 링크:" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                    <TextBox x:Name="TxtTemplateUrl" Style="{DynamicResource ThemeTextBoxStyle}" Height="32" Margin="0,0,0,8"/>

                                    <TextBlock Text="2. 유저 라이선스 CSV 웹게시 링크:" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                    <TextBox x:Name="TxtUserUrl" Style="{DynamicResource ThemeTextBoxStyle}" Height="32" Margin="0,0,0,8"/>

                                    <TextBlock Text="3. 스프레드시트 신규 템플릿/자연어 업로드 웹앱 URL (Google Apps Script):" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                    <TextBox x:Name="TxtUploadUrl" Style="{DynamicResource ThemeTextBoxStyle}" Height="32" Margin="0,0,0,12"/>

                                    <Button Content="🔄 구글 시트에서 전체 최신 동기화 실행" Style="{DynamicResource ThemeButtonStyle}" Width="260" Height="36" HorizontalAlignment="Left" Click="BtnSyncAll_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 5: 버전 정보 & 로컬 AI -->
                <TabItem Header="ℹ️ 버전 &amp; 로컬 AI" Padding="14,6">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="64" Height="64" Background="{DynamicResource ThemeAccent}" CornerRadius="10" VerticalAlignment="Top">
                            <TextBlock Text="ME" Foreground="White" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="ChatHelper Millennium Edition" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            <TextBlock Text="Version 2.1.0 (Build 2026.11.18)" FontSize="12" Foreground="{DynamicResource ThemeSubText}" Margin="0,3,0,14"/>

                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="🤖 초경량 로컬 AI 시맨틱 검색 엔진 (계획)" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                    <TextBlock Text="• 수백 개의 키워드를 외우지 않아도, 사용자가 '돈 환불해달래' 처럼 자연어로 검색하면 AI가 의미를 파악해 최적의 답변 템플릿을 추천합니다." FontSize="12" Foreground="{DynamicResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="• 기반 기술: Microsoft ONNX Runtime + BGE-m3 / KR-SBERT INT8 (약 35MB 단일 파일, CPU 0.01초 추론, 인터넷 불필요)" FontSize="12" Foreground="{DynamicResource ThemeSubText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 3. 하단 상태 바 및 저장 버튼 -->
            <Grid Grid.Row="2" Margin="14,0,14,0">
                <TextBlock x:Name="LblStatusBar" VerticalAlignment="Center" Text="준비 완료" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="💾 설정 저장 및 적용" Style="{DynamicResource ThemeButtonStyle}" Width="140" Height="32" Margin="0,0,8,0" Click="BtnSaveAndClose_Click"/>
                    <Button Content="닫기" Style="{DynamicResource ThemeButtonStyle}" Width="80" Height="32" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
