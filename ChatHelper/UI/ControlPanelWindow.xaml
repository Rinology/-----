<Window x:Class="ChatHelper.UI.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper 제어판" 
        Height="840" Width="1320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource ThemeBg}"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <Border Margin="0" CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
            Background="{DynamicResource ThemeBg}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 1. 타이틀 바 -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,10,0">
                    <TextBlock Text="ChatHelper 환경 설정" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="13.5" FontFamily="Malgun Gothic, Segoe UI" VerticalAlignment="Center"/>
                    <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 1.5. 상단 통합 헤더: 로그인 계정 · 종료 시 로그아웃 체크 · 시트 자동 갱신 주기 (기존 동기화&계정 탭 통합) -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="14,10,14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LblCurrentUserInfo" Grid.Column="0" Text="로그인 정보 로드 중..." FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox x:Name="ChkLogoutOnExit" Grid.Column="1" Content="종료 시 로그아웃 (다음 실행 시 아이디 새로 입력)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Grid.Column="2" Content="다른 계정 로그온" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="10,0" Click="BtnRelogin_Click"/>

                    <TextBlock Grid.Column="4" Text="시트 자동 갱신 주기:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbAutoSyncInterval" Grid.Column="5" Width="175" Height="28" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,8,0">
                        <ComboBoxItem Content="5분마다 자동 갱신" Tag="5"/>
                        <ComboBoxItem Content="10분마다 자동 갱신" Tag="10"/>
                        <ComboBoxItem Content="15분마다 자동 갱신 (권장)" Tag="15"/>
                        <ComboBoxItem Content="30분마다 자동 갱신" Tag="30"/>
                        <ComboBoxItem Content="60분(1시간)마다 갱신" Tag="60"/>
                        <ComboBoxItem Content="자동 갱신 사용 안 함 (수동)" Tag="0"/>
                    </ComboBox>
                    <Button Grid.Column="6" Content="🔄 지금 동기화" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="12,0" Click="BtnSyncAll_Click"/>
                    <CheckBox x:Name="ChkQuickSaveWithoutDialog" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 2. 탭 컨트롤 (3개 핵심 탭: 커맨드 & 시트 관리 / 단축키 & 기능 / 디자인 & 표시) -->
            <TabControl Grid.Row="2" Margin="14,10,14,6" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" FontSize="13">
                
                <!-- 탭 1: 커맨드 & 업무 시트 통합 관리 -->
                <TabItem Header="📋 커맨드 &amp; 시트 관리" Padding="16,8">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 1행: 업무 프로필 선택 & 개인 시트 토글 바 -->
                        <Border Grid.Row="0" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="업무 프로필:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbActivePreset" Grid.Column="1" Width="200" Height="30" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnPresetSwitch" Grid.Column="2" Content="✅ 적용 및 동기화" Style="{DynamicResource ThemeButtonStyle}" Height="30" Padding="12,0" Margin="8,0,0,0" Click="BtnPresetSwitch_Click"/>
                                    <Button x:Name="BtnPresetRefresh" Grid.Column="3" Content="🔄 목록 새로고침" Style="{DynamicResource ThemeButtonStyle}" Height="30" Padding="10,0" Margin="6,0,0,0" Click="BtnPresetRefresh_Click"/>
                                    <TextBlock x:Name="LblActiveProfile" Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentText}" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="BtnToggleUserSheetManager" Grid.Column="5" Content="⚙ 개인 시트 추가/삭제 ▾" Style="{DynamicResource ThemeButtonStyle}" Height="30" Padding="12,0" Click="BtnToggleUserSheetManager_Click"/>
                                </Grid>
                                <ProgressBar x:Name="PbarProfileSync" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,2"/>
                                <TextBlock x:Name="TxtProfileSyncStatus" Text="" FontSize="11.5" Foreground="{DynamicResource ThemeSubText}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- 2행: 접이식 개인 시트 추가/삭제 패널 (서버 저장 vs 로컬 PC 저장) -->
                        <Border x:Name="PanelUserSheetManager" Grid.Row="1" Visibility="Collapsed"
                                Background="{DynamicResource ThemePanelBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <TabControl Background="Transparent" BorderThickness="0">
                                <!-- 서브 탭 1: 서버 저장 (GAS 클라우드 · 계정 로밍) -->
                                <TabItem Header="☁️ 서버 시트 (계정 로밍)" Padding="12,5">
                                    <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                                        <StackPanel>
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                                        <TextBlock Text="1) 공유 안내: 구글 시트 우측 상단 [공유]에서 " FontSize="11.5" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                        <TextBox Text="taerin@qualisports.kr" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="Bold" FontSize="11.5" Foreground="#1D4ED8" VerticalAlignment="Center" Padding="2,0"/>
                                                        <TextBlock Text=" 을(를) 편집자로 추가하세요." FontSize="11.5" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                        <Button Content="복사" Padding="6,1" Margin="6,0,0,0" FontSize="10.5" Cursor="Hand" Click="BtnCopyGasEmail_Click"/>
                                                    </StackPanel>
                                                    <TextBlock Text="2) 필수 1행 헤더 컬럼:  keyword  |  contentKeyword  |  title  |  content  |  category" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                                </StackPanel>
                                            </Border>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="115"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtGasProfileName" Grid.Column="0" Height="28" Padding="6,4" ToolTip="시트 이름 (예: 내 팀 시트)"/>
                                                <TextBox x:Name="TxtGasProfileUrl" Grid.Column="2" Height="28" Padding="6,4" ToolTip="구글 시트 편집 URL"/>
                                                <TextBox x:Name="TxtGasProfileTab" Grid.Column="4" Height="28" Padding="6,4" Text="채팅템플릿" ToolTip="시트 하단 탭 이름"/>
                                                <Button x:Name="BtnAddGasProfile" Grid.Column="6" Content="☁️ 추가" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="12,0" Click="BtnAddGasProfile_Click"/>
                                                <Button x:Name="BtnDeleteGasProfile" Grid.Column="8" Content="🗑 삭제" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="10,0" Click="BtnDeleteGasProfile_Click"/>
                                            </Grid>

                                            <ProgressBar x:Name="PbarGasProfile" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtGasProfileStatus" Text="" FontSize="11.5" Visibility="Collapsed" Margin="0,0,0,4"/>
                                            <ListBox x:Name="LstGasUserProfiles" Height="72" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" FontSize="11.5"/>
                                        </StackPanel>
                                    </Border>
                                </TabItem>

                                <!-- 서브 탭 2: 로컬 PC 저장 (구글 시트 없이 이 PC에서만 바로 입력/사용) -->
                                <TabItem Header="💻 로컬 PC 시트 (이 PC 전용)" Padding="12,5">
                                    <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="구글 시트 연결 없이 이 PC에서만 쓰는 나만의 문구 목록입니다. 목록 이름만 추가한 뒤 우측 커맨드 편집기에서 단축어와 답변을 바로 입력하세요." FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtLocalProfileName" Grid.Column="0" Height="28" Padding="8,4" ToolTip="목록 이름 (예: 내 개인 문구)"/>
                                                <Button x:Name="BtnAddLocalProfile" Grid.Column="2" Content="💻 내 PC 목록 추가 및 사용" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="12,0" Click="BtnAddLocalProfile_Click"/>
                                                <Button x:Name="BtnDeleteLocalProfile" Grid.Column="4" Content="🗑 선택 삭제" Style="{DynamicResource ThemeButtonStyle}" Height="28" Padding="10,0" Click="BtnDeleteLocalProfile_Click"/>
                                            </Grid>

                                            <TextBlock x:Name="TxtLocalProfileStatus" Text="" FontSize="11.5" Visibility="Collapsed" Margin="0,0,0,4"/>
                                            <ListBox x:Name="LstLocalUserProfiles" Height="72" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" FontSize="11.5"/>
                                        </StackPanel>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </Border>

                        <!-- 3행: 좌측(목록) ↔ 우측(긴 본문 상세 편집기) 2단 분할 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" MinWidth="420"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="0.85*" MinWidth="360"/>
                            </Grid.ColumnDefinitions>

                            <!-- 좌측: 검색 필터 + DataGrid -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="검색 필터:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtCmdFilter" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="30"
                                             ToolTip="단축어, 제목, 본문 내용으로 바로 검색합니다"
                                             TextChanged="TxtCmdFilter_TextChanged"/>
                                </Grid>

                                <DataGrid x:Name="DgTemplates" Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          Background="{DynamicResource ThemeSurfaceBg}"
                                          BorderBrush="{DynamicResource ThemeBorder}"
                                          MinRowHeight="46"
                                          FontSize="12.5"
                                          SelectionChanged="DgTemplates_SelectionChanged"
                                          MouseDoubleClick="DgTemplates_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="단축어" Binding="{Binding Keyword}" Width="95">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="6,4"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="155">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="카테고리" Binding="{Binding Category}" Width="85">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="내용 미리보기" Binding="{Binding Content}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Margin" Value="6,5"/>
                                                    <Setter Property="LineHeight" Value="19"/>
                                                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                                    <Setter Property="MaxHeight" Value="38"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                            <!-- 우측: 긴 본문 전용 상세 보기/편집기 (남은 세로 공간 전체 + 자동 스크롤) -->
                            <Border Grid.Column="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                    Background="{DynamicResource ThemeSurfaceBg}" CornerRadius="6" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="선택 항목 상세 보기 / 편집" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,10"/>

                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="단축어 (키워드)" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtKw" Style="{DynamicResource ThemeTextBoxStyle}" Height="32"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="카테고리" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtCat" Style="{DynamicResource ThemeTextBoxStyle}" Height="32"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                        <TextBlock Text="제목" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtTitle" Style="{DynamicResource ThemeTextBoxStyle}" Height="32"/>
                                    </StackPanel>

                                    <Grid Grid.Row="3" Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="본문 내용 (길면 자동 스크롤 생성)" FontSize="11.5" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtContentLength" Text="0자" FontSize="11" Foreground="{DynamicResource ThemeSubText}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBox x:Name="TxtContent" Grid.Row="1"
                                                 Style="{DynamicResource ThemeTextBoxStyle}"
                                                 VerticalContentAlignment="Top"
                                                 Padding="10"
                                                 FontSize="13"
                                                 TextBlock.LineHeight="22"
                                                 TextBlock.LineStackingStrategy="BlockLineHeight"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="TxtContent_TextChanged"/>
                                    </Grid>

                                    <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
                                        <Button Content="➕ 신규 추가" Style="{DynamicResource ThemeButtonStyle}" MinWidth="95" Height="34" Margin="0,0,6,4" Click="BtnAdd_Click"/>
                                        <Button Content="✏️ 수정 적용" Style="{DynamicResource ThemeButtonStyle}" MinWidth="95" Height="34" Margin="0,0,6,4" Click="BtnUpdate_Click"/>
                                        <Button Content="🗑️ 선택 삭제" Style="{DynamicResource ThemeButtonStyle}" MinWidth="95" Height="34" Margin="0,0,6,4" Click="BtnDelete_Click"/>
                                        <Button Content="🧹 비우기" Style="{DynamicResource ThemeButtonStyle}" MinWidth="78" Height="34" Margin="0,0,0,4" Click="BtnClearForm_Click"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 탭 2: 단축키 & 보조 기능 -->
                <TabItem Header="⌨️ 단축키 &amp; 기능" Padding="16,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- 카드 1: 수동 팝업 단축키 -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="수동 검색 팝업 단축키 (기본: Alt+Q)" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="전역 호출 단축키:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtGlobalHotkey" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" FontSize="14" TextChanged="TxtGlobalHotkey_TextChanged"/>
                                        <TextBlock x:Name="LblHotkeyWarning" Grid.Column="2" Text="" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                    <TextBlock Text="• 언제 어디서든 이 키를 누르면 템플릿 검색창이 즉시 열리며, 변경 시 내부 단축키(Alt+X/T) 및 Windows 충돌을 실시간으로 검사합니다." Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- 카드 2: 자동완성 완성 키 모드 (Shift + Space 기본 권장) -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="자동완성 추천 알약 완성 트리거" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="트리거 접두 키:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtTriggerKey" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" FontSize="14" Text="\"/>
                                        <TextBlock Grid.Column="2" Text="(한국어 키보드 원화 기호 ₩ 포함)" Foreground="{DynamicResource ThemeSubText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="완성 트리거 키 조합 선택:" FontWeight="SemiBold" Margin="0,4,0,8"/>

                                    <RadioButton x:Name="RadioSlashTab" Margin="8,6" IsChecked="True" Checked="CompleteKeyMode_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="[ ₩ / \ ] + [ Tab ]" Foreground="{DynamicResource ThemeAccentText}" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="추천 알약이 떴을 때 \와 Tab을 누르면 완성 (기본 권장 · 2~9번 \+숫자)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RadioShiftSpace" Margin="8,6" Checked="CompleteKeyMode_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="[ Shift + Space ]" Foreground="{DynamicResource ThemeAccentText}" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="추천 알약이 떴을 때 Shift+Space로 완성 (2~9번 Ctrl+숫자)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RadioSlashOnly" Margin="8,6" Checked="CompleteKeyMode_Changed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                    <TextBlock Text="[ ₩ / \ ] 단독 즉시 실행" Foreground="{DynamicResource ThemeAccentText}" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="\ 키를 누르자마자 1번 추천 답변으로 즉시 치환 완성" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtSlashOnlyNotice" Text="※ '\' 단독 즉시 실행 모드에서는 1번 항목이 즉시 치환되므로 추천 알약 형태가 [단일 알약 툴팁]으로 자동 고정됩니다." Foreground="#B45309" FontWeight="SemiBold" FontSize="12" Margin="30,4,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- 카드 3: 편의 보조 기능 (기존 디자인 탭에서 이동) -->
                            <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="실시간 계산 및 드래그 영문 번역 기능" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkEnableMathCalc" Content="🧮 사칙연산 자동 계산 기능 사용 (예: 5 * 10 = 입력 시 50 즉시 추천)" Margin="8,4,0,8" IsChecked="True" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="ChkEnableTranslation" Content="🌐 드래그 선택 Google 영문 번역 사용 (문장 드래그 후 Alt+T 입력 시 원문 ↔ 영문 비교 카드 표시)" Margin="8,4,0,2" IsChecked="False" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 3: 디자인 & 표시 (좌측 설정 ↔ 우측 실시간 예시 화면 2단 구성) -->
                <TabItem Header="🎨 디자인 &amp; 표시" Padding="16,8">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 좌측: 직관적인 디자인 설정 카드들 (어색한 0~6 번호 제거) -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel>
                                <!-- 포인트 컬러 (실제 컬러 원형 스와치 표시) -->
                                <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="UI 포인트 컬러 (Windows 11 Fluent 라이트)" FontWeight="Bold" FontSize="14.5" Margin="0,0,0,4"/>
                                        <TextBlock Text="화이트 베이스 위에 적용할 포인트 컬러를 선택하세요. 우측 예시 화면과 창에 즉시 반영됩니다." Foreground="{DynamicResource ThemeSubText}" FontSize="11.5" Margin="0,0,0,10"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioAccentBlue" GroupName="UiAccentGroup" Margin="6,4,16,4" IsChecked="True" Checked="RadioAccent_Checked">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="16" Height="16" Fill="#DBEAFE" Stroke="#60A5FA" StrokeThickness="1.5" Margin="0,0,6,0"/>
                                                    <TextBlock Text="파스텔 블루 (기본)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="RadioAccentGreen" GroupName="UiAccentGroup" Margin="6,4,16,4" Checked="RadioAccent_Checked">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="16" Height="16" Fill="#D1FAE5" Stroke="#34D399" StrokeThickness="1.5" Margin="0,0,6,0"/>
                                                    <TextBlock Text="파스텔 민트" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="RadioAccentLavender" GroupName="UiAccentGroup" Margin="6,4,16,4" Checked="RadioAccent_Checked">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="16" Height="16" Fill="#EDE9FE" Stroke="#A78BFA" StrokeThickness="1.5" Margin="0,0,6,0"/>
                                                    <TextBlock Text="파스텔 라벤더" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="RadioAccentPeach" GroupName="UiAccentGroup" Margin="6,4,16,4" Checked="RadioAccent_Checked">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="16" Height="16" Fill="#FFEDD5" Stroke="#FB923C" StrokeThickness="1.5" Margin="0,0,6,0"/>
                                                    <TextBlock Text="파스텔 피치" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="RadioAccentPink" GroupName="UiAccentGroup" Margin="6,4,16,4" Checked="RadioAccent_Checked">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="16" Height="16" Fill="#FCE7F3" Stroke="#F472B6" StrokeThickness="1.5" Margin="0,0,6,0"/>
                                                    <TextBlock Text="파스텔 핑크" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 추천 알약 모양 · 1~9 번호 선택 · 크기 · 자동 숨김 시간 통합 카드 -->
                                <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="추천 알약(Suggestion Pill) 모양 및 크기" FontWeight="Bold" FontSize="14.5" Margin="0,0,0,8"/>

                                        <RadioButton x:Name="RadioModeInline" GroupName="DisplayModeGroup" Content="단일 스마트 알약 툴팁 (가장 정확도 높은 1개만 간결하게 표시)" Margin="6,4" IsChecked="True" Checked="DesignOption_Changed"/>

                                        <StackPanel Orientation="Horizontal" Margin="6,4">
                                            <RadioButton x:Name="RadioModeHorizontal" GroupName="DisplayModeGroup" Content="가로형 멀티 추천 바 — 최대 표시 개수:" VerticalAlignment="Center" Checked="DesignOption_Changed"/>
                                            <ComboBox x:Name="CmbMaxCandidates" Width="72" Height="26" Margin="8,0,6,0" VerticalContentAlignment="Center" SelectionChanged="DesignOption_Changed">
                                                <ComboBoxItem Content="3개"/>
                                                <ComboBoxItem Content="4개"/>
                                                <ComboBoxItem Content="5개" IsSelected="True"/>
                                                <ComboBoxItem Content="6개"/>
                                                <ComboBoxItem Content="7개"/>
                                                <ComboBoxItem Content="8개"/>
                                                <ComboBoxItem Content="9개"/>
                                                <ComboBoxItem Content="10개"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 1~9 숫자 키 선택 옵션 (알약 모양 설정 바로 아래로 통합) -->
                                        <CheckBox x:Name="ChkNumbers" Content="멀티 알약 표시 중 트리거+숫자(1~9) 키로 번호 즉시 선택 허용" Margin="26,2,0,6" IsChecked="True" FontWeight="SemiBold" Checked="DesignOption_Changed" Unchecked="DesignOption_Changed"/>

                                        <RadioButton x:Name="RadioModeManual" GroupName="DisplayModeGroup" Content="자동 알약 끄기 (수동 검색 Alt+Q 전용)" Margin="6,4" Checked="DesignOption_Changed"/>

                                        <Border Height="1" Background="{DynamicResource ThemePanelBorder}" Margin="0,10"/>

                                        <TextBlock Text="알약 글자 및 카드 크기:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <RadioButton x:Name="RadioPillScale1" Content="보통 (1.0x)" Margin="6,3,16,3" Checked="DesignOption_Changed"/>
                                            <RadioButton x:Name="RadioPillScale2" Content="크게 (2.0x · 권장)" Margin="6,3,16,3" IsChecked="True" Checked="DesignOption_Changed"/>
                                            <RadioButton x:Name="RadioPillScale3" Content="아주 크게 (3.0x)" Margin="6,3,16,3" Checked="DesignOption_Changed"/>
                                        </WrapPanel>

                                        <StackPanel Orientation="Horizontal" Margin="6,2,0,0">
                                            <TextBlock Text="추천 알약 자동 숨김 시간:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="CmbAutoHideSeconds" Width="130" Height="26" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="5초" Tag="5"/>
                                                <ComboBoxItem Content="8초" Tag="8"/>
                                                <ComboBoxItem Content="12초 (기본)" Tag="12" IsSelected="True"/>
                                                <ComboBoxItem Content="15초" Tag="15"/>
                                                <ComboBoxItem Content="20초 (최대)" Tag="20"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 알약 표시 위치 및 간격 -->
                                <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="추천 알약 표시 위치 및 커서 간격" FontWeight="Bold" FontSize="14.5" Margin="0,0,0,8"/>
                                        <RadioButton x:Name="RadioPosNearby1" Content="채팅 커서 바로 근처 밀착 (+15px)" Margin="6,4" Checked="DesignOption_Changed"/>
                                        <RadioButton x:Name="RadioPosNearby2" Content="채팅 커서 기준 넉넉한 간격 (+35px · 기본 권장)" Margin="6,4" IsChecked="True" Checked="DesignOption_Changed"/>
                                        <RadioButton x:Name="RadioPosFar" Content="채팅창 시야 확보용 원거리 (+65px)" Margin="6,4" Checked="DesignOption_Changed"/>
                                        <RadioButton x:Name="RadioPosMouse" Content="마우스 포인터 위치 기준 (마우스 커서 옆에 표시)" Margin="6,4" Checked="DesignOption_Changed"/>
                                        <RadioButton x:Name="RadioPosFixed" Content="모니터 우측 하단 고정 알림 위치" Margin="6,4" Checked="DesignOption_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- 투명도 및 마스터창 표시 -->
                                <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="창 투명도 (뒤 창 비침) 및 마스터창 표시" FontWeight="Bold" FontSize="14.5" Margin="0,0,0,8"/>

                                        <TextBlock Text="추천 알약 · 검색창 투명도:" FontWeight="SemiBold" FontSize="12.5" Margin="0,2,0,4"/>
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <RadioButton x:Name="RadioOpacity100" Content="100% 불투명" Margin="6,3,14,3" Checked="DesignOption_Changed"/>
                                            <RadioButton x:Name="RadioOpacity90" Content="90% 은은함(권장)" Margin="6,3,14,3" IsChecked="True" Checked="DesignOption_Changed"/>
                                            <RadioButton x:Name="RadioOpacity80" Content="80% 반투명" Margin="6,3,14,3" Checked="DesignOption_Changed"/>
                                            <RadioButton x:Name="RadioOpacity70" Content="70% 많이 비침" Margin="6,3,14,3" Checked="DesignOption_Changed"/>
                                        </WrapPanel>

                                        <TextBlock Text="화면 중앙 하단 마스터 도킹 바 투명도:" FontWeight="SemiBold" FontSize="12.5" Margin="0,2,0,4"/>
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <RadioButton x:Name="RadioStatusOpacity100" Content="100% 불투명" Margin="6,3,14,3" Checked="DesignOption_Changed"/>
                                            <RadioButton x:Name="RadioStatusOpacity85" Content="85% 은은함(권장)" Margin="6,3,14,3" IsChecked="True" Checked="DesignOption_Changed"/>
                                            <RadioButton x:Name="RadioStatusOpacity65" Content="65% 반투명" Margin="6,3,14,3" Checked="DesignOption_Changed"/>
                                            <RadioButton x:Name="RadioStatusOpacity45" Content="45% 많이 비침" Margin="6,3,14,3" Checked="DesignOption_Changed"/>
                                        </WrapPanel>

                                        <CheckBox x:Name="ChkShowStatusWindow" Content="화면 중앙 하단 및 작업표시줄에 마스터 도킹 바 항상 보이기" Margin="6,4,0,2" IsChecked="True" FontWeight="SemiBold"/>
                                        <TextBlock Text="  (체크 해제 시 작업표시줄에서 숨겨지고 트레이 아이콘으로만 작동합니다.)" Foreground="{DynamicResource ThemeSubText}" FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 우측: 실시간 예시 화면 (Live Preview) -->
                        <Border Grid.Column="2" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="실시간 예시 화면 (미리보기)" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,4"/>
                                <TextBlock Text="좌측 옵션을 변경하면 아래 예시 화면에서 컬러·모양·크기·투명도·위치를 즉시 확인할 수 있습니다." FontSize="11.5" Foreground="{DynamicResource ThemeSubText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <!-- 가상 모니터 배경 캔버스 (투명도 비침 체감용 체크/채팅 배경) -->
                                <Border Background="#DCE6F2" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="10" Padding="14" Height="370">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 뒤편 가상 채팅창 배경 (투명도에 따라 알약 뒤로 비침) -->
                                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="[뒤편 채팅창 화면 예시]" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock Text="고객: 배송은 언제쯤 출발하나요?" FontSize="12" Foreground="#334155" Margin="0,2,0,2"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="상담원 입력창: 배송" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"/>
                                                    <Border Background="#2563EB" Width="2" Height="14" Margin="2,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="PreviewLocationText" Text="표시 위치 ➔ [채팅 커서 기준 +35px]" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentText}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 중앙: 추천 알약 실시간 프리뷰 (위·뒤·아래에 실제 채팅 대화 여러 줄을 깔아 투명도 비침과 위치 이동이 명확히 보이도록 구성) -->
                                        <Grid Grid.Row="1" VerticalAlignment="Stretch" Margin="0,4">
                                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="고객: 오늘 주문하면 언제 발송되나요? 택배사도 궁금합니다." FontSize="11.5" Foreground="#334155" Margin="0,2"/>
                                                    <TextBlock Text="상담원: 평일 오후 2시 이전 주문 건은 당일 출고됩니다." FontSize="11.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,2"/>
                                                    <TextBlock Text="고객: 감사합니다! 송장번호는 어디서 확인하나요?" FontSize="11.5" Foreground="#334155" Margin="0,2"/>
                                                    <TextBlock Text="상담원: 출고 후 알림톡으로 송장번호가 자동 발송됩니다." FontSize="11.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,2"/>
                                                    <TextBlock Text="※ 투명도(70%~100%)와 위치 설정에 따라 알약의 위치·비침이 실시간으로 바뀝니다." FontSize="11" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 마우스 포인터 위치 선택 시 표시되는 가상 마우스 커서 앵커 -->
                                            <Border x:Name="PreviewMouseIndicator"
                                                    Background="#1E293B"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,12,18,0"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="🖱️ 마우스 포인터 위치" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>

                                            <Border x:Name="PreviewPillBorder"
                                                    Background="{DynamicResource ThemePillBg}"
                                                    BorderBrush="{DynamicResource ThemeAccentBorder}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="8"
                                                    Padding="12,8"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="12,26,12,0">
                                                <StackPanel>
                                                    <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="인식됨: &quot;배송&quot;  (⏱ 12s)" FontSize="10.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="1" Text="✕" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" ToolTip="우측 상단 ✕ 버튼으로 언제든 닫기 가능"/>
                                                        </Grid>
                                                    </Border>
                                                    <WrapPanel x:Name="PreviewPillItemsPanel" Orientation="Horizontal"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- 하단: 중앙 하단 마스터 도킹 바 프리뷰 -->
                                        <Border x:Name="PreviewDockBorder" Grid.Row="2"
                                                Background="{DynamicResource ThemeHudBg}"
                                                BorderBrush="{DynamicResource ThemeHudBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,6"
                                                HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="ON" FontSize="11" FontWeight="Bold" Margin="0,0,8,0"/>
                                                <TextBlock Text="▲ 1/3 ▼  |  CS상담  ·  검색  ·  기호  ·  로그  ·  설정" FontSize="11" Foreground="{DynamicResource ThemeText}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="PreviewSummaryText" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSubText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                </TabControl>

            <!-- 3. 하단 상태 바 및 저장 버튼 (잘림 방지) -->
            <Grid Grid.Row="3" Margin="16,0,16,0">
                <TextBlock x:Name="LblStatusBar" VerticalAlignment="Center" Text="준비 완료" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="설정 저장 및 적용" Style="{DynamicResource ThemeButtonStyle}" MinWidth="150" Height="34" Margin="0,0,8,0" Click="BtnSaveAndClose_Click"/>
                    <Button Content="닫기" Style="{DynamicResource ThemeButtonStyle}" MinWidth="80" Height="34" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
