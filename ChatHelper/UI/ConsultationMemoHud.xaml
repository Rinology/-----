<Window x:Class="ChatHelper.UI.ConsultationMemoHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemePillBg}"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded">

    <Border x:Name="MainBorder"
            Margin="0"
            CornerRadius="8"
            Background="{DynamicResource ThemePillBg}"
            BorderBrush="{DynamicResource ThemeAccentBorder}"
            BorderThickness="1.5"
            Padding="10,7"
            MinWidth="340" MaxWidth="520"
            MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <StackPanel Orientation="Vertical">
            <!-- 헤더: 메모 개수 + 단축키 안내 + 편집/초기화 -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtMemoHeader" Grid.Column="0"
                           Text="📝 상담 메모 (0개)"
                           FontSize="11.5" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeAccentText}"
                           FontFamily="Malgun Gothic, Segoe UI"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Button Grid.Column="1" Content="편집 (\+N)"
                        FontSize="10.5" Padding="6,2" Margin="0,0,4,0"
                        Background="{DynamicResource ThemeSurfaceBg}" Foreground="{DynamicResource ThemeSubText}"
                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                        Cursor="Hand" Focusable="False"
                        ToolTip="메모 순서 편집 및 상세 조합기 열기 (\+N)"
                        Click="BtnOpenDetail_Click"/>

                <Button Grid.Column="2" Content="초기화"
                        FontSize="10.5" Padding="6,2" Margin="0,0,4,0"
                        Background="#FEF2F2" Foreground="#B91C1C"
                        BorderBrush="#FECACA" BorderThickness="1"
                        Cursor="Hand" Focusable="False"
                        ToolTip="쌓인 상담 메모를 모두 비웁니다"
                        Click="BtnClearMemos_Click"/>

                <Button Grid.Column="3" Content="✕"
                        Width="20" Height="20" Padding="0"
                        FontSize="10.5" FontWeight="Bold"
                        Background="Transparent" Foreground="#64748B" BorderThickness="0"
                        Cursor="Hand" Focusable="False"
                        ToolTip="HUD 숨기기 (메모는 유지됨)"
                        Click="BtnHideHud_Click"/>
            </Grid>

            <!-- 누적된 스무고개 키워드 칩 -->
            <WrapPanel x:Name="ChipsPanel" Orientation="Horizontal" Margin="0,0,0,6"/>

            <!-- 스무고개 일치 템플릿 / 조합 최종 미리보기 알약 -->
            <Border x:Name="PreviewCard"
                    Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="6" Padding="8,5" Margin="0,0,0,5">
                <StackPanel>
                    <TextBlock x:Name="TxtMatchStatus"
                               Text="✨ 누적 답변 조합 미리보기"
                               FontSize="10.5" FontWeight="Bold" Foreground="#059669"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtFinalPreview"
                               Text=""
                               FontSize="11.5" Foreground="#1E293B"
                               TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"
                               FontFamily="Malgun Gothic, Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- 하단 1클릭 / 단축키 액션 바 -->
            <Grid>
                <TextBlock Text="\+M 추가  ·  \+F / Ctrl+Shift+Enter 완성입력"
                           FontSize="10" Foreground="{DynamicResource ThemeSubText}"
                           VerticalAlignment="Center" FontFamily="Malgun Gothic, Segoe UI"/>
                <Button HorizontalAlignment="Right"
                        Content="✅ 최종 입력 (\+F)"
                        FontSize="11" FontWeight="Bold"
                        Padding="9,3"
                        Background="#ECFDF5" Foreground="#065F46"
                        BorderBrush="#6EE7B7" BorderThickness="1"
                        Cursor="Hand" Focusable="False"
                        Click="BtnInsertFinal_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
