<Window x:Class="ChatHelper.UI.ConsultationMemoHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeBg}"
        Width="744" Height="524"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded">

    <Border x:Name="MainBorder"
            Margin="0"
            CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
            Background="{DynamicResource ThemeBg}"
            BorderBrush="{DynamicResource ThemeAccentBorder}"
            BorderThickness="1.5"
            MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- 1. 타이틀 바 -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Cursor="SizeAll">
                <Grid Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtMemoHeader" Text="📝 상담 스무고개 메모 HUD (0개 누적)"
                                   Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="13" FontFamily="Malgun Gothic, Segoe UI"/>
                        <TextBlock Text="포커스 비탈취 · 대화 중 계속 유지" Foreground="{DynamicResource ThemeSubText}" FontSize="11" Margin="10,2,0,0" FontFamily="Malgun Gothic, Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="상세 편집 (\+N)"
                                FontSize="11" Padding="8,3" Margin="0,0,6,0"
                                Background="{DynamicResource ThemeSurfaceBg}" Foreground="{DynamicResource ThemeSubText}"
                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                Cursor="Hand" Focusable="False"
                                ToolTip="메모 순서 편집 및 상세 조합기 열기 (\+N)"
                                Click="BtnOpenDetail_Click"/>
                        <Button Content="초기화 (\+C)"
                                FontSize="11" Padding="8,3" Margin="0,0,6,0"
                                Background="#FEF2F2" Foreground="#B91C1C"
                                BorderBrush="#FECACA" BorderThickness="1"
                                Cursor="Hand" Focusable="False"
                                ToolTip="쌓인 상담 메모를 모두 비웁니다 (\+C)"
                                Click="BtnClearMemos_Click"/>
                        <Button Content="✕" Width="24" Height="24" Padding="0"
                                FontSize="11.5" FontWeight="Bold"
                                Background="Transparent" Foreground="#64748B" BorderThickness="0"
                                Cursor="Hand" Focusable="False"
                                ToolTip="HUD 숨기기 (메모는 유지됨)"
                                Click="BtnHideHud_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 누적된 스무고개 키워드 칩 바 -->
            <Border Grid.Row="1" Margin="12,10,12,6" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                <StackPanel>
                    <TextBlock Text="🏷 누적된 스무고개 키워드 조건" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeSubText}" Margin="0,0,0,5"/>
                    <WrapPanel x:Name="ChipsPanel" Orientation="Horizontal"/>
                </StackPanel>
            </Border>

            <!-- 3. 누적된 메모 카드 목록 (크고 읽기 쉽게 스크롤 지원) -->
            <Border Grid.Row="2" Margin="12,0,12,6" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📌 달아둔 메모 &amp; 답변 조각" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MemoCardsPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 4. 스무고개 일치 / 최종 완성 문장 미리보기 -->
            <Border x:Name="PreviewCard" Grid.Row="3" Margin="12,0,12,4"
                    Background="#F8FAFC" BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="12,9">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <TextBlock x:Name="TxtMatchStatus"
                                   Text="✨ 누적 답변 조합 미리보기"
                                   FontSize="11.5" FontWeight="Bold" Foreground="#059669"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="조합 형식:" FontSize="11" Foreground="{DynamicResource ThemeSubText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="CmbHudJoinMode" Width="145" Height="24" FontSize="11" VerticalContentAlignment="Center" SelectionChanged="CmbHudJoinMode_SelectionChanged">
                                <ComboBoxItem Content="문단 구분 (빈 줄)" Tag="Paragraph" IsSelected="True"/>
                                <ComboBoxItem Content="줄바꿈으로 연결" Tag="LineBreak"/>
                                <ComboBoxItem Content="번호 매기기 (1. 2. 3.)" Tag="Numbered"/>
                                <ComboBoxItem Content="불릿 목록 (•)" Tag="Bulleted"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtFinalPreview"
                                   Text=""
                                   FontSize="12.5" LineHeight="20" Foreground="#1E293B"
                                   TextWrapping="Wrap"
                                   FontFamily="Malgun Gothic, Segoe UI"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 5. 하단 액션 바 -->
            <Grid Grid.Row="4" Margin="14,0,14,0">
                <TextBlock Text="\+M 메모 추가  ·  \+C 일괄 초기화  ·  \+F / Ctrl+Shift+Enter 최종 완성 입력  ·  \+N 편집"
                           FontSize="11.5" Foreground="{DynamicResource ThemeSubText}"
                           VerticalAlignment="Center" FontFamily="Malgun Gothic, Segoe UI"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="✅ 최종 완성 입력 (\+F)"
                        Style="{DynamicResource ThemeButtonStyle}"
                        FontSize="12" FontWeight="Bold"
                        Padding="14,5"
                        Cursor="Hand" Focusable="False"
                        Click="BtnInsertFinal_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
