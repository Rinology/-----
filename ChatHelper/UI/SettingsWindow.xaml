<Window x:Class="ChatHelper.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="채팅 도우미 설정" 
        Height="520" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#52525B"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 커서 추적 모드 선택 -->
        <GroupBox Grid.Row="0" Header="📌 자동완성 표시 모드 선택">
            <StackPanel>
                <RadioButton x:Name="RadioInlinePill" Content="옵션 1: 스마트폰 인라인 툴팁 (추천)"/>
                <TextBlock Text="  • 글을 칠 때 커서 옆에 [트리거+Tab] 알약 칩 1개가 작게 따라다님" Foreground="#A1A1AA" FontSize="11" Margin="20,0,0,4"/>

                <RadioButton x:Name="RadioHorizontalBar" Content="옵션 2: 가로형 미니 추천 바"/>
                <TextBlock Text="  • 커서 위에 2~3개의 추천 후보가 가로로 나열됨 (트리거+Tab 또는 트리거+1~3)" Foreground="#A1A1AA" FontSize="11" Margin="20,0,0,4"/>

                <RadioButton x:Name="RadioManualOnly" Content="옵션 3: 수동 단축키 모드 (Alt+Q만 사용)"/>
                <TextBlock Text="  • 타이핑 중에는 조용히 숨어있고, 필요할 때만 Alt+Q로 호출" Foreground="#A1A1AA" FontSize="11" Margin="20,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 2. 트리거 조합 키 설정 (방해 방지) -->
        <GroupBox Grid.Row="1" Header="⌨️ 단축키 &amp; 방해 방지 트리거 키 설정">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="트리거 접두사 키: " VerticalAlignment="Center" Foreground="#E4E4E7"/>
                    <TextBox x:Name="TxtTriggerKey" Grid.Column="1" Text="\" Width="80" HorizontalAlignment="Left"/>
                </Grid>
                <CheckBox x:Name="ChkRequireTriggerForTab" Content="일반 Tab 키 방해 방지 (트리거 키가 붙었을 때만 Tab으로 완성)" IsChecked="True"/>
                <CheckBox x:Name="ChkEnableNumbers" Content="트리거 상태에서 1~9 숫자 키로 바로 선택" IsChecked="True"/>
            </StackPanel>
        </GroupBox>

        <!-- 3. 구글 스프레드시트 연동 -->
        <GroupBox Grid.Row="2" Header="📊 구글 스프레드시트 CSV 연동">
            <StackPanel>
                <TextBox x:Name="TxtRemoteUrl" Margin="0,0,0,6" TextWrapping="NoWrap"/>
                <Button Content="🔄 지금 시트에서 최신 템플릿 동기화" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="8,4" Click="BtnSync_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- 4. 하단 버튼 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="취소" Background="#3F3F46" Foreground="White" Width="70" Padding="6,4" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="저장 및 적용" Background="#2563EB" Foreground="White" FontWeight="Bold" Width="90" Padding="6,4" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
