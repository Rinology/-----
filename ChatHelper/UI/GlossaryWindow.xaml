<Window x:Class="ChatHelper.UI.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사내 용어집 관리 (2번 시트 연동)"
        Width="720" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#C0C0C0"
        FontFamily="Tahoma, Gulim, Segoe UI">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 검색 및 새로고침 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="BtnSync" Content="🔄 시트 새로고침" DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0"
                    Style="{DynamicResource ThemeButtonStyle}" Click="BtnSync_Click"/>
            <Button x:Name="BtnDelete" Content="🗑 선택 삭제" DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0"
                    Style="{DynamicResource ThemeButtonStyle}" Click="BtnDelete_Click"/>
            <TextBox x:Name="TxtSearch" Height="28" VerticalContentAlignment="Center" Padding="6,2"
                     TextChanged="TxtSearch_TextChanged" ToolTip="용어, 유사어, 설명 검색"/>
        </DockPanel>

        <!-- 용어집 목록 -->
        <DataGrid x:Name="GridGlossary" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Background="White" Margin="0,0,0,10"
                  HeadersVisibility="Column" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="용어 (term)" Binding="{Binding Term}" Width="110"/>
                <DataGridTextColumn Header="유사어 (aliases)" Binding="{Binding Aliases}" Width="120"/>
                <DataGridTextColumn Header="공식 설명 (description)" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="주의사항 (guide)" Binding="{Binding Guide}" Width="140"/>
                <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 새 용어 추가 영역 -->
        <GroupBox Grid.Row="2" Header="➕ 새 사내 용어 추가 (구글 2번 시트 '용어집'에 즉시 반영)" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                    <TextBlock Text="용어 (필수)" FontWeight="Bold" FontSize="11"/>
                    <TextBox x:Name="TxtTerm" Height="26" Padding="4,2"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,6,6">
                    <TextBlock Text="유사어 (쉼표구분)" FontSize="11"/>
                    <TextBox x:Name="TxtAliases" Height="26" Padding="4,2"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,6,6">
                    <TextBlock Text="분류" FontSize="11"/>
                    <TextBox x:Name="TxtCategory" Text="제품" Height="26" Padding="4,2"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,6">
                    <TextBlock Text="주의사항 (선택)" FontSize="11"/>
                    <TextBox x:Name="TxtGuide" Height="26" Padding="4,2"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,6,0">
                    <TextBlock Text="공식 설명 (필수 - AI가 이 내용을 바탕으로 답변 생성)" FontWeight="Bold" FontSize="11"/>
                    <TextBox x:Name="TxtDescription" Height="28" Padding="4,2"/>
                </StackPanel>
                <Button x:Name="BtnAdd" Grid.Row="1" Grid.Column="3" Content="💾 용어집에 추가" Height="28" VerticalAlignment="Bottom"
                        FontWeight="Bold" Style="{DynamicResource ThemeButtonStyle}" Click="BtnAdd_Click"/>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="TxtStatus" Grid.Row="3" Text="준비 완료" FontSize="11.5" Foreground="#333333"/>
    </Grid>
</Window>
