<Window x:Class="ChatHelper.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows에 로그온" 
        Height="210" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#C0C0C0"
        ResizeMode="NoResize"
        BorderBrush="#FFFFFF"
        BorderThickness="2">
    <Border BorderThickness="1" BorderBrush="#000000">
        <Border BorderThickness="1" BorderBrush="#808080">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 윈도우 98 타이틀 바 -->
                <Grid Background="{StaticResource Win98TitleGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="🔑 Windows에 로그온" Foreground="White" FontWeight="Bold" FontSize="11" FontFamily="Tahoma, Gulim"/>
                    </StackPanel>
                    <Button Style="{StaticResource Win98CloseButtonStyle}" HorizontalAlignment="Right" Margin="0,0,2,0" Click="BtnClose_Click"/>
                </Grid>

                <!-- 메인 내용 -->
                <Grid Grid.Row="1" Margin="12,10,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="스프레드시트에 등록된 사용자 아이디를 입력하세요." 
                               FontFamily="Tahoma, Gulim" FontSize="11" Foreground="#000000" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="사용자 이름(U):" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Tahoma, Gulim" FontSize="11"/>
                        <TextBox x:Name="TxtUserId" Grid.Column="1" Style="{StaticResource Win98TextBoxStyle}" Height="22" VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- 만료일 / 상태 표시 라벨 -->
                    <TextBlock x:Name="LblStatus" Grid.Row="2" Text="" FontSize="11" Foreground="#000080" TextWrapping="Wrap"/>

                    <!-- 하단 버튼들 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="확인" Style="{StaticResource Win98ButtonStyle}" Width="75" Margin="0,0,6,0" Click="BtnLogin_Click" IsDefault="True"/>
                        <Button Content="취소" Style="{StaticResource Win98ButtonStyle}" Width="75" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
