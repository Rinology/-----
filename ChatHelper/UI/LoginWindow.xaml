<Window x:Class="ChatHelper.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사용자 인증 로그온" 
        Height="270" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <Border CornerRadius="{DynamicResource ThemeWindowCornerRadius}" 
            BorderThickness="{DynamicResource ThemeWindowBorderThickness}" 
            BorderBrush="{DynamicResource ThemeBorder}"
            Background="{DynamicResource ThemeBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 타이틀 바 -->
            <Grid Background="{DynamicResource ThemeTitleBg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="🔑 ChatHelper 사용자 로그온" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="13"/>
                </StackPanel>
                <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" Margin="0,0,4,0" Click="BtnClose_Click"/>
            </Grid>

            <!-- 메인 내용 -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="스프레드시트에 등록된 CS 상담사 아이디를 입력하세요." 
                           FontSize="12" Foreground="{DynamicResource ThemeSubText}" Margin="0,0,0,14"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="사용자 ID:" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}"/>
                    <TextBox x:Name="TxtUserId" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" VerticalContentAlignment="Center" FontSize="14"/>
                </Grid>

                <!-- 로그인 유지 체크박스 -->
                <CheckBox x:Name="ChkKeepLoggedIn" Grid.Row="2" Content="로그인 상태 유지 (다음 실행 시 자동 접속)" 
                          FontSize="12" Margin="100,4,0,10" Foreground="{DynamicResource ThemeText}"/>

                <!-- 만료일 / 상태 표시 라벨 -->
                <TextBlock x:Name="LblStatus" Grid.Row="3" Text="" FontSize="11" Foreground="#DC2626" TextWrapping="Wrap"/>

                <!-- 하단 버튼들 -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="로그온" Style="{DynamicResource ThemeButtonStyle}" Width="90" Height="32" Margin="0,0,8,0" Click="BtnLogin_Click" IsDefault="True"/>
                    <Button Content="닫기" Style="{DynamicResource ThemeButtonStyle}" Width="80" Height="32" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
