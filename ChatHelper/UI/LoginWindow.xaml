<Window x:Class="ChatHelper.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사용자 인증 로그온" 
        Height="270" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <!-- 윈도우 98 정통 4단계 3D Raised 입체 프레임 -->
    <Border BorderThickness="1,1,0,0" BorderBrush="#FFFFFF">
        <Border BorderThickness="0,0,1,1" BorderBrush="#000000">
            <Border BorderThickness="1,1,0,0" BorderBrush="#DFDFDF">
                <Border BorderThickness="0,0,1,1" BorderBrush="#808080" Background="#C0C0C0" Padding="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 타이틀 바 -->
                        <Grid Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                <TextBlock Text="⌨" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI Emoji, Tahoma"/>
                                <TextBlock Text="ChatHelper 사용자 로그온" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" FontFamily="Tahoma, Gulim, Segoe UI"/>
                            </StackPanel>
                            <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" Margin="0,0,3,0" Click="BtnClose_Click"/>
                        </Grid>

                        <!-- 메인 내용 -->
                        <Grid Grid.Row="1" Margin="16,12,16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="등록된 사용자(상담사) 아이디를 입력하세요." 
                                       Foreground="#000000" FontSize="12" Margin="0,0,0,12" FontFamily="Tahoma, Gulim, Segoe UI"/>

                            <!-- 입력 필드 -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="사용자 ID:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12.5" Foreground="#000000" FontFamily="Tahoma, Gulim, Segoe UI"/>
                                <TextBox x:Name="TxtUserId" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="28" VerticalContentAlignment="Center" FontSize="13"/>
                            </Grid>

                            <!-- 로그인 유지 체크박스 -->
                            <CheckBox x:Name="ChkKeepLoggedIn" Grid.Row="2" Content="로그인 상태 유지 (다음 실행 시 자동 접속)" 
                                      FontSize="11.5" Margin="80,2,0,8" Foreground="#000000" FontFamily="Tahoma, Gulim, Segoe UI"/>

                            <!-- 만료일 / 상태 표시 라벨 -->
                            <TextBlock x:Name="LblStatus" Grid.Row="3" Text="" FontSize="11" Foreground="#DC2626" TextWrapping="Wrap" FontFamily="Tahoma, Gulim, Segoe UI"/>

                            <!-- 하단 버튼들 -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button x:Name="BtnLogin" Content="확인" Style="{DynamicResource ThemeButtonStyle}" Width="80" Height="26" Margin="0,0,6,0" Click="BtnLogin_Click" IsDefault="True"/>
                                <Button x:Name="BtnCancel" Content="취소" Style="{DynamicResource ThemeButtonStyle}" Width="75" Height="26" Click="BtnClose_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
