<Window x:Class="ChatHelper.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatHelper - 로그인"
        Height="328" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource ThemeBg}"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Border Margin="0"
            CornerRadius="{DynamicResource ThemeWindowCornerRadius}"
            Background="{DynamicResource ThemeBg}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 타이틀 바 -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeTitleBg}" BorderBrush="{DynamicResource ThemePanelBorder}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <TextBlock Text="ChatHelper" Foreground="{DynamicResource ThemeTitleText}" FontWeight="Bold" FontSize="12.5" FontFamily="pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy" VerticalAlignment="Center"/>
                    <Button Style="{DynamicResource ThemeCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 메인 내용 -->
            <Grid Grid.Row="1" Margin="24,16,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 헤더 문구 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="로그인" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource ThemeText}" FontFamily="pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy" Margin="0,0,0,4"/>
                    <TextBlock Text="부여받은 아이디와 비밀번호를 입력해 주세요."
                               Foreground="{DynamicResource ThemeSubText}" FontSize="12" FontFamily="pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy"/>
                </StackPanel>

                <!-- 1. 아이디 입력 필드 -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="아이디" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" FontFamily="pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy"/>
                    <TextBox x:Name="TxtUserId" Grid.Column="1" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" VerticalContentAlignment="Center" FontSize="13"/>
                </Grid>

                <!-- 2. 비밀번호 입력 필드 -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="비밀번호" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" FontFamily="pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy"/>
                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="TxtPassword" Style="{DynamicResource ThemePasswordBoxStyle}" Height="34" VerticalContentAlignment="Center" FontSize="13"/>
                        <TextBox x:Name="TxtPasswordVisible" Style="{DynamicResource ThemeTextBoxStyle}" Height="34" VerticalContentAlignment="Center" FontSize="13" Visibility="Collapsed"/>
                    </Grid>
                    <Button x:Name="BtnTogglePw" Grid.Column="2" Content="보기" Style="{DynamicResource ThemeButtonStyle}" Height="34" Margin="6,0,0,0" Click="BtnTogglePw_Click"/>
                </Grid>

                <!-- 3. 아이디 저장 체크박스 -->
                <CheckBox x:Name="ChkKeepLoggedIn" Grid.Row="3" Content="아이디 기억하기 (비밀번호는 저장하지 않음)"
                          FontSize="12" Margin="66,2,0,8" Foreground="{DynamicResource ThemeSubText}" FontFamily="pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy"/>

                <!-- 4. 프로그레스바 (원격 시트 인증 진행 시) -->
                <ProgressBar x:Name="ProgressBarLoading" Grid.Row="4" Height="3" Margin="0,2,0,4" IsIndeterminate="True" Visibility="Collapsed"/>

                <!-- 5. 상태 및 오류 라벨 -->
                <TextBlock x:Name="LblStatus" Grid.Row="5" Text="" FontSize="11.5" Foreground="#DC2626" TextWrapping="Wrap" MinHeight="18" FontFamily="pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy"/>

                <!-- 6. 하단 버튼들 -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="BtnCancel" Content="종료" Style="{DynamicResource ThemeButtonStyle}" Width="80" Height="34" Margin="0,0,8,0" Click="BtnClose_Click" IsCancel="True"/>
                    <Button x:Name="BtnLogin" Content="로그인" Style="{DynamicResource ThemeButtonStyle}"
                            Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccentBorder}" Foreground="{DynamicResource ThemeAccentText}"
                            Width="104" Height="34" Click="BtnLogin_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
