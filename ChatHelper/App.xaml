<Application x:Class="ChatHelper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Win98Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="ThemeFontFamily">pack://application:,,,/ChatHelper;component/Assets/Fonts/#Paperlogy</FontFamily>
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}"/>
            </Style>
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}"/>
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
